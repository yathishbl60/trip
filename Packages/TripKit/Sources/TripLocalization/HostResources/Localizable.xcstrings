      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get the next unvisited place while tracking, or today's next saved item. Choose a trip or use your current trip."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ट्रैकिंग के दौरान अगला न देखा गया स्थान, या आज का अगला सहेजा गया आइटम प्राप्त करें। कोई यात्रा चुनें या अपनी वर्तमान यात्रा का उपयोग करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಟ್ರ್ಯಾಕಿಂಗ್ ಮಾಡುವಾಗ ಮುಂದಿನ ಭೇಟಿ ನೀಡದ ಸ್ಥಳವನ್ನು ಅಥವಾ ಇಂದಿನ ಮುಂದಿನ ಉಳಿಸಿದ ಐಟಂ ಅನ್ನು ಪಡೆಯಿರಿ. ಪ್ರವಾಸವನ್ನು ಆಯ್ಕೆಮಾಡಿ ಅಥವಾ ನಿಮ್ಮ ಪ್ರಸ್ತುತ ಪ್ರವಾಸವನ್ನು ಬಳಸಿ."
          }
        }
      }
    },
