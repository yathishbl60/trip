    "intent_ask_saved_trip_description": {
      "comment": "@symbol askSavedTripDescription\n@group Intents\n@parameters \nSystem action metadata for source-backed trip questions.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use on-device Apple Intelligence to find saved stays, transport, reservations, places, or times. Returns saved records and a spoken summary; requires Apple Intelligence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सहेजे गए ठहरने के स्थान, परिवहन, आरक्षण, जगहें या समय खोजने के लिए डिवाइस पर Apple Intelligence का उपयोग करें। सहेजे गए विवरण और बोलकर सारांश देता है; Apple Intelligence आवश्यक है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಉಳಿಸಿದ ವಸತಿ, ಸಾರಿಗೆ, ಕಾಯ್ದಿರಿಸುವಿಕೆ, ಸ್ಥಳಗಳು ಅಥವಾ ಸಮಯಗಳನ್ನು ಹುಡುಕಲು ಸಾಧನದಲ್ಲಿನ Apple Intelligence ಬಳಸಿ. ಉಳಿಸಿದ ದಾಖಲೆಗಳು ಮತ್ತು ಧ್ವನಿ ಸಾರಾಂಶವನ್ನು ನೀಡುತ್ತದೆ; Apple Intelligence ಅಗತ್ಯವಿದೆ."
          }
        }
      }
    },
