        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಉಳಿಸಿದ ಸ್ಥಳಕ್ಕೆ ಭೇಟಿ ನೀಡಲಾಗಿದೆ ಎಂದು ಗುರುತಿಸಿ"
