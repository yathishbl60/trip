{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "comment": "A representation of a checklist item that includes the checklist item's title, the name of the trip it belongs to, and a checkmark if the item is complete.",
      "isCommentAutoGenerated": true
    },
    "%@ · %@": {
      "comment": "A label that shows the title of the trip and the name of the stop.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ – %@": {
      "comment": "A subheading that displays the start and end dates of the weather data's validity.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ – %2$@"
          }
        }
      }
    },
    "%@, %@": {
