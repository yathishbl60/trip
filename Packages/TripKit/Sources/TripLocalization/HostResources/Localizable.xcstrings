    "intent_import_trip_booking_description": {
      "comment": "@symbol importTripBookingIntentDescription\n@group NativeTravel\n@parameters \nShortcuts booking import action description.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review a booking PDF, image, or text file and add confirmed details to a saved trip."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बुकिंग की PDF, तस्वीर या टेक्स्ट फ़ाइल की समीक्षा करें और पुष्टि किए गए विवरण सहेजी गई यात्रा में जोड़ें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಬುಕಿಂಗ್ PDF, ಚಿತ್ರ ಅಥವಾ ಪಠ್ಯ ಫೈಲ್ ಪರಿಶೀಲಿಸಿ ಮತ್ತು ದೃಢೀಕರಿಸಿದ ವಿವರಗಳನ್ನು ಉಳಿಸಿದ ಪ್ರವಾಸಕ್ಕೆ ಸೇರಿಸಿ."
          }
        }
      }
    },
    "intent_mark_saved_visit": {
      "comment": "Siri saved-place actions. Navigation and visit tracking remain separate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark Saved Place Visited"
          }
        },
        "hi": {
