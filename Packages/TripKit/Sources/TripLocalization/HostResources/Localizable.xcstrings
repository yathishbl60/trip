    "intent_open_trip_section_description": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a saved trip’s itinerary, today view, map, checklist, collections, or saved-detail search. Keeps the existing navigation hierarchy."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सहेजी गई यात्रा की योजना, आज का दृश्य, मानचित्र, चेकलिस्ट, संग्रह या विवरण खोज खोलें। मौजूदा नेविगेशन क्रम बना रहता है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಉಳಿಸಿದ ಪ್ರವಾಸದ ಯೋಜನೆ, ಇಂದಿನ ನೋಟ, ನಕ್ಷೆ, ಪರಿಶೀಲನಾ ಪಟ್ಟಿ, ಸಂಗ್ರಹಗಳು ಅಥವಾ ವಿವರ ಹುಡುಕಾಟ ತೆರೆಯಿರಿ. ಈಗಿರುವ ನ್ಯಾವಿಗೇಶನ್ ಕ್ರಮ ಉಳಿಯುತ್ತದೆ."
          }
        }
      }
    },
    "intent_open_trip_tool": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Trip Tool"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा उपकरण खोलें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರವಾಸ ಸಾಧನ ತೆರೆಯಿರಿ"
          }
        }
      }
    },
    "intent_open_trip_tool_description": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open trip editing or a Calendar or Reminders export review. The person reviews and confirms changes in Trip; opening a review does not export anything."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा संपादन या Calendar अथवा Reminders निर्यात समीक्षा खोलें। व्यक्ति Trip में बदलावों की समीक्षा और पुष्टि करता है; समीक्षा खोलने से निर्यात नहीं होता।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರವಾಸ ಸಂಪಾದನೆ ಅಥವಾ Calendar ಅಥವಾ Reminders ರಫ್ತು ಪರಿಶೀಲನೆ ತೆರೆಯಿರಿ. ಬಳಕೆದಾರರು Trip ನಲ್ಲಿ ಬದಲಾವಣೆಗಳನ್ನು ಪರಿಶೀಲಿಸಿ ದೃಢೀಕರಿಸುತ್ತಾರೆ; ಪರಿಶೀಲನೆ ತೆರೆಯುವುದರಿಂದ ರಫ್ತು ಆಗುವುದಿಲ್ಲ."
          }
        }
      }
    },
    "intent_parameter_booking_file": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A PDF, image, or text booking document to open for review before saving."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सहेजने से पहले समीक्षा के लिए खोलने वाला PDF, चित्र या टेक्स्ट बुकिंग दस्तावेज़।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಉಳಿಸುವ ಮೊದಲು ಪರಿಶೀಲನೆಗಾಗಿ ತೆರೆಯಬೇಕಾದ PDF, ಚಿತ್ರ ಅಥವಾ ಪಠ್ಯ ಬುಕಿಂಗ್ ದಾಖಲೆ."
          }
        }
      }
    },
    "intent_parameter_checklist_complete": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "True marks this item done; false marks it incomplete. Repeating the same value leaves it unchanged."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सही होने पर पूरा और गलत होने पर अधूरा चिह्नित करता है। वही मान दोहराने से स्थिति नहीं बदलती।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಸರಿ ಎಂದರೆ ಪೂರ್ಣ; ತಪ್ಪು ಎಂದರೆ ಅಪೂರ್ಣ ಎಂದು ಗುರುತಿಸುತ್ತದೆ. ಅದೇ ಮೌಲ್ಯವನ್ನು ಪುನರಾವರ್ತಿಸಿದರೆ ಸ್ಥಿತಿ ಬದಲಾಗುವುದಿಲ್ಲ."
          }
        }
      }
    },
    "intent_parameter_checklist_item": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exact existing checklist item and its trip, not a newly invented item."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "उसकी यात्रा सहित सटीक मौजूदा चेकलिस्ट आइटम; नया बनाया हुआ आइटम नहीं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಅದರ ಪ್ರವಾಸದೊಂದಿಗೆ ನಿಖರವಾಗಿ ಇರುವ ಪರಿಶೀಲನಾ ಪಟ್ಟಿಯ ಅಂಶ; ಹೊಸದಾಗಿ ಕಲ್ಪಿಸಿದ ಅಂಶವಲ್ಲ."
          }
        }
      }
    },
    "intent_parameter_checklist_title": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One packing or preparation item, from 1 to 80 characters. Existing matching items are reused."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 से 80 अक्षरों का एक पैकिंग या तैयारी आइटम। मेल खाने वाला मौजूदा आइटम दोबारा उपयोग होता है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1ರಿಂದ 80 ಅಕ್ಷರಗಳ ಒಂದು ಪ್ಯಾಕಿಂಗ್ ಅಥವಾ ತಯಾರಿ ಅಂಶ. ಹೊಂದಿಕೆಯಾಗುವ ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಅಂಶವನ್ನು ಮರುಬಳಸಲಾಗುತ್ತದೆ."
          }
        }
      }
    },
    "intent_parameter_day_number": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved trip day, starting at 1. It must exist in the selected trip."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सहेजी गई यात्रा का दिन, 1 से शुरू। वह चुनी गई यात्रा में मौजूद होना चाहिए।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಉಳಿಸಿದ ಪ್ರವಾಸದ ದಿನ, 1ರಿಂದ ಪ್ರಾರಂಭ. ಅದು ಆಯ್ಕೆಮಾಡಿದ ಪ್ರವಾಸದಲ್ಲಿ ಇರಬೇಕು."
          }
        }
      }
    },
    "intent_parameter_day_tool": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose schedule editing, planning preview, weather, or adding places for the specified itinerary day."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "चुने हुए यात्रा दिन के लिए समय संपादन, योजना पूर्वावलोकन, मौसम या स्थान जोड़ना चुनें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ನಿರ್ದಿಷ್ಟ ಪ್ರವಾಸದ ದಿನಕ್ಕೆ ವೇಳಾಪಟ್ಟಿ ಸಂಪಾದನೆ, ಯೋಜನೆ ಪೂರ್ವನೋಟ, ಹವಾಮಾನ ಅಥವಾ ಸ್ಥಳಗಳನ್ನು ಸೇರಿಸುವುದನ್ನು ಆಯ್ಕೆಮಾಡಿ."
          }
        }
      }
    },
    "intent_parameter_directions_visit": {
      "comment": "Siri saved-place actions. Navigation and visit tracking remain separate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exact saved itinerary place to navigate to, with valid map coordinates. Bookings without a saved place are not supported."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वह सहेजी कार्यक्रम जगह जहाँ जाना है, मान्य मानचित्र निर्देशांकों के साथ। सहेजी जगह के बिना बुकिंग समर्थित नहीं है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಮಾನ್ಯ ನಕ್ಷೆ ನಿರ್ದೇಶಾಂಕಗಳಿರುವ, ತಲುಪಬೇಕಾದ ನಿಖರ ಉಳಿಸಿದ ವೇಳಾಪಟ್ಟಿ ಸ್ಥಳ. ಉಳಿಸಿದ ಸ್ಥಳವಿಲ್ಲದ ಬುಕಿಂಗ್ ಬೆಂಬಲಿತವಾಗಿಲ್ಲ."
          }
        }
      }
    },
    "intent_parameter_draft_days": {
      "comment": "Siri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Number of days in the suggested draft, from 1 to 5. Existing plans change only after review and saving."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सुझाए गए मसौदे में दिनों की संख्या, 1 से 5। समीक्षा और सहेजने के बाद ही मौजूदा योजना बदलती है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಸೂಚಿತ ಕರಡಿನ ದಿನಗಳ ಸಂಖ್ಯೆ, 1ರಿಂದ 5. ಪರಿಶೀಲಿಸಿ ಉಳಿಸಿದ ನಂತರ ಮಾತ್ರ ಈಗಿನ ಯೋಜನೆ ಬದಲಾಗುತ್ತದೆ."
          }
        }
      }
    },
    "intent_parameter_new_trip_days": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number of itinerary days to create, from 1 to 30."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा योजना में बनाने वाले दिनों की संख्या, 1 से 30।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ರಚಿಸಬೇಕಾದ ಪ್ರವಾಸದ ದಿನಗಳ ಸಂಖ್ಯೆ, 1 ರಿಂದ 30."
          }
        }
      }
    },
    "intent_parameter_new_trip_departure": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The departure date for the new trip, using the device’s current calendar and time zone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नई यात्रा की प्रस्थान तिथि, डिवाइस के वर्तमान कैलेंडर और समय क्षेत्र के अनुसार।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಸಾಧನದ ಪ್ರಸ್ತುತ ಕ್ಯಾಲೆಂಡರ್ ಮತ್ತು ಸಮಯ ವಲಯದ ಪ್ರಕಾರ ಹೊಸ ಪ್ರವಾಸದ ನಿರ್ಗಮನ ದಿನಾಂಕ."
          }
        }
      }
    },
    "intent_parameter_new_trip_name": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name for the new saved trip, from 1 to 80 characters."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नई सहेजी यात्रा का नाम, 1 से 80 अक्षर।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಹೊಸ ಉಳಿಸಿದ ಪ್ರವಾಸದ ಹೆಸರು, 1 ರಿಂದ 80 ಅಕ್ಷರಗಳು."
          }
        }
      }
    },
    "intent_parameter_place_search": {
      "comment": "Siri saved-place actions. Navigation and visit tracking remain separate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One place name or address to search in Apple Maps. The person chooses a result in Trip before anything is saved. Do not provide a URL or booking document."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple Maps में खोजने के लिए एक जगह का नाम या पता। कुछ सहेजने से पहले व्यक्ति Trip में परिणाम चुनता है। URL या बुकिंग दस्तावेज़ न दें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple Maps ನಲ್ಲಿ ಹುಡುಕಲು ಒಂದು ಸ್ಥಳದ ಹೆಸರು ಅಥವಾ ವಿಳಾಸ. ಉಳಿಸುವ ಮೊದಲು ವ್ಯಕ್ತಿ Trip ನಲ್ಲಿ ಫಲಿತಾಂಶ ಆಯ್ಕೆಮಾಡುತ್ತಾರೆ. URL ಅಥವಾ ಬುಕಿಂಗ್ ದಾಖಲೆ ನೀಡಬೇಡಿ."
          }
        }
      }
    },
    "intent_parameter_preferences": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional travel or packing preferences stated by the person, up to 500 characters."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "व्यक्ति की बताई वैकल्पिक यात्रा या पैकिंग पसंद, अधिकतम 500 अक्षर।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ವ್ಯಕ್ತಿ ಹೇಳಿದ ಐಚ್ಛಿಕ ಪ್ರಯಾಣ ಅಥವಾ ಪ್ಯಾಕಿಂಗ್ ಆದ್ಯತೆಗಳು, ಗರಿಷ್ಠ 500 ಅಕ್ಷರಗಳು."
          }
        }
      }
    },
    "intent_parameter_processing": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use on-device processing unless the person explicitly chooses Private Cloud Compute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "व्यक्ति के स्पष्ट रूप से Private Cloud Compute चुनने पर ही उसका उपयोग करें; अन्यथा डिवाइस पर प्रोसेस करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ವ್ಯಕ್ತಿ ಸ್ಪಷ್ಟವಾಗಿ Private Cloud Compute ಆಯ್ಕೆ ಮಾಡಿದಾಗ ಮಾತ್ರ ಅದನ್ನು ಬಳಸಿ; ಇಲ್ಲದಿದ್ದರೆ ಸಾಧನದಲ್ಲೇ ಪ್ರಕ್ರಿಯೆಗೊಳಿಸಿ."
          }
        }
      }
    },
    "intent_parameter_saved_detail": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One existing saved itinerary record, identified by its trip and day."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा और दिन से पहचाना जाने वाला एक मौजूदा सहेजा गया कार्यक्रम विवरण।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಅದರ ಪ್ರವಾಸ ಮತ್ತು ದಿನದಿಂದ ಗುರುತಿಸಲಾದ ಒಂದು ಉಳಿಸಿದ ವೇಳಾಪಟ್ಟಿ ವಿವರ."
          }
        }
      }
    },
    "intent_parameter_saved_trip": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The existing saved trip. Distinguish trips with the same name by departure date."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "मौजूदा सहेजी गई यात्रा। एक जैसे नाम वाली यात्राओं को प्रस्थान की तारीख से पहचानें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಈಗಾಗಲೇ ಉಳಿಸಿದ ಪ್ರವಾಸ. ಒಂದೇ ಹೆಸರಿನ ಪ್ರವಾಸಗಳನ್ನು ಹೊರಡುವ ದಿನಾಂಕದಿಂದ ಗುರುತಿಸಿ."
          }
        }
      }
    },
    "intent_parameter_section": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The section of the saved trip to open."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सहेजी गई यात्रा का वह भाग जिसे खोलना है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ತೆರೆಯಬೇಕಾದ ಉಳಿಸಿದ ಪ್ರವಾಸದ ವಿಭಾಗ."
          }
        }
      }
    },
    "intent_parameter_timed_visit": {
      "comment": "Siri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An existing place visit in an itinerary day, not a flight, stay, or reservation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा के दिन में मौजूद जगह का भ्रमण, उड़ान, ठहराव या आरक्षण नहीं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ವೇಳಾಪಟ್ಟಿಯ ದಿನದಲ್ಲಿ ಇರುವ ಸ್ಥಳ ಭೇಟಿ, ವಿಮಾನ, ವಾಸ್ತವ್ಯ ಅಥವಾ ಕಾಯ್ದಿರಿಸುವಿಕೆಯಲ್ಲ."
          }
        }
      }
    },
    "intent_parameter_tracked_visit": {
      "comment": "Siri saved-place actions. Navigation and visit tracking remain separate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved place the person says they visited. It must be next in the tracked day or already recorded; never substitute another place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वह सहेजी जगह जिसे व्यक्ति देख चुका है। यह ट्रैक किए दिन की अगली या पहले दर्ज जगह होनी चाहिए; दूसरी जगह न चुनें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ವ್ಯಕ್ತಿ ಭೇಟಿ ನೀಡಿರುವುದಾಗಿ ಹೇಳಿದ ಉಳಿಸಿದ ಸ್ಥಳ. ಇದು ಟ್ರ್ಯಾಕ್ ಮಾಡುವ ದಿನದ ಮುಂದಿನ ಸ್ಥಳ ಅಥವಾ ಈಗಾಗಲೇ ದಾಖಲಾದ ಸ್ಥಳವಾಗಿರಬೇಕು; ಬೇರೆ ಸ್ಥಳವನ್ನು ಬದಲಿಸಬೇಡಿ."
          }
        }
      }
    },
    "intent_parameter_trip_date": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day to read in the trip’s time zone. Omit to use today."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा के समय क्षेत्र में पढ़ने वाला दिन। आज के लिए खाली छोड़ें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರವಾಸದ ಸಮಯ ವಲಯದಲ್ಲಿ ಓದಬೇಕಾದ ದಿನ. ಇಂದಿನ ದಿನಕ್ಕಾಗಿ ಖಾಲಿ ಬಿಡಿ."
          }
        }
      }
    },
    "intent_parameter_trip_tool": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit trip details, or review exporting saved bookings to Calendar or incomplete checklist items to Reminders."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा विवरण संपादित करें या सहेजी बुकिंग Calendar में अथवा अधूरे चेकलिस्ट आइटम Reminders में निर्यात करने की समीक्षा करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರವಾಸ ವಿವರ ಸಂಪಾದಿಸಿ, ಅಥವಾ ಉಳಿಸಿದ ಬುಕಿಂಗ್‌ಗಳನ್ನು Calendar ಗೆ ಅಥವಾ ಅಪೂರ್ಣ ಪರಿಶೀಲನಾ ಅಂಶಗಳನ್ನು Reminders ಗೆ ರಫ್ತು ಮಾಡುವುದನ್ನು ಪರಿಶೀಲಿಸಿ."
          }
        }
      }
    },
    "intent_parameter_visit_timing": {
      "comment": "Siri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the timing changes requested by the person. Minutes are whole numbers; arrival uses the itinerary day’s local time zone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "केवल व्यक्ति के माँगे गए समय बदलाव। मिनट पूर्ण संख्या में हैं; आगमन यात्रा के दिन के स्थानीय समय क्षेत्र में है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ವ್ಯಕ್ತಿ ಕೇಳಿದ ಸಮಯ ಬದಲಾವಣೆಗಳು ಮಾತ್ರ. ನಿಮಿಷಗಳು ಪೂರ್ಣ ಸಂಖ್ಯೆಗಳು; ಆಗಮನವು ವೇಳಾಪಟ್ಟಿಯ ದಿನದ ಸ್ಥಳೀಯ ಸಮಯ ವಲಯದಲ್ಲಿದೆ."
          }
        }
      }
    },
    "intent_parameter_weather": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include available weather for that day only when requested. A forecast is not guaranteed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "माँगे जाने पर ही उस दिन का उपलब्ध मौसम शामिल करें। पूर्वानुमान मिलना निश्चित नहीं है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಕೇಳಿದಾಗ ಮಾತ್ರ ಆ ದಿನಕ್ಕೆ ಲಭ್ಯವಿರುವ ಹವಾಮಾನವನ್ನು ಸೇರಿಸಿ. ಮುನ್ಸೂಚನೆ ದೊರೆಯುವುದು ಖಚಿತವಲ್ಲ."
          }
