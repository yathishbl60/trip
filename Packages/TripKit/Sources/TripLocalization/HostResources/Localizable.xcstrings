    "intent_open_day_tool_description": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open an existing day’s schedule editor, planning preview, weather review, or place picker. Changes and new places require review and saving in Trip."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "मौजूदा दिन का समय संपादक, योजना पूर्वावलोकन, मौसम समीक्षा या स्थान चयन खोलें। बदलाव और नए स्थान Trip में समीक्षा के बाद सहेजे जाते हैं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಈಗಿರುವ ದಿನದ ವೇಳಾಪಟ್ಟಿ ಸಂಪಾದಕ, ಯೋಜನೆ ಪೂರ್ವನೋಟ, ಹವಾಮಾನ ಪರಿಶೀಲನೆ ಅಥವಾ ಸ್ಥಳ ಆಯ್ಕೆ ತೆರೆಯಿರಿ. ಬದಲಾವಣೆಗಳು ಮತ್ತು ಹೊಸ ಸ್ಥಳಗಳನ್ನು Trip ನಲ್ಲಿ ಪರಿಶೀಲಿಸಿ ಉಳಿಸಬೇಕು."
          }
        }
      }
    },
    "intent_open_my_trips": {
