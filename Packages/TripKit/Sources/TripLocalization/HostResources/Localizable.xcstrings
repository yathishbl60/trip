    "intent_directions_saved_visit_description": {
      "comment": "Siri saved-place actions. Navigation and visit tracking remain separate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Apple Maps directions to the saved coordinates of one itinerary place. Does not mark a visit complete, start trip tracking, or claim a live arrival time."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कार्यक्रम की एक जगह के सहेजे निर्देशांक तक Apple Maps दिशा-निर्देश खोलें। भ्रमण पूरा नहीं करता, ट्रैकिंग शुरू नहीं करता और लाइव आगमन समय नहीं बताता।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ವೇಳಾಪಟ್ಟಿಯ ಒಂದು ಸ್ಥಳದ ಉಳಿಸಿದ ನಿರ್ದೇಶಾಂಕಗಳಿಗೆ Apple Maps ದಿಕ್ಕುಗಳನ್ನು ತೆರೆಯಿರಿ. ಭೇಟಿಯನ್ನು ಪೂರ್ಣಗೊಳಿಸುವುದಿಲ್ಲ, ಟ್ರ್ಯಾಕಿಂಗ್ ಆರಂಭಿಸುವುದಿಲ್ಲ ಅಥವಾ ನೇರ ಆಗಮನ ಸಮಯ ಹೇಳುವುದಿಲ್ಲ."
          }
        }
      }
    },
