        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರವಾಸದಲ್ಲಿ ಉಳಿಸಿದ ನಿರ್ದಿಷ್ಟ ಸಂಗ್ರಹ. ಪ್ರಸ್ತುತ ಉಳಿಸಿದ ಪ್ರವಾಸಗಳ ಪಟ್ಟಿಯಿಂದ ಅದನ್ನು ಗುರುತಿಸಿ."
          }
        }
