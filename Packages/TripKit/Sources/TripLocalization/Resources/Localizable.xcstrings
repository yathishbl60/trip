    "collection_limit_reached" : {
      "comment": "@symbol collectionLimitReached\n@group SiriCollections\n@parameters ",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trip has reached its collection limit. Use an existing collection or remove one in Trip first."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस यात्रा में संग्रहों की अधिकतम संख्या हो गई है। कोई मौजूदा संग्रह इस्तेमाल करें या पहले Trip में कोई संग्रह हटाएँ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಈ ಪ್ರವಾಸದಲ್ಲಿ ಸಂಗ್ರಹಗಳ ಗರಿಷ್ಠ ಮಿತಿ ತಲುಪಿದೆ. ಇರುವ ಸಂಗ್ರಹವನ್ನು ಬಳಸಿ ಅಥವಾ ಮೊದಲು Trip ನಲ್ಲಿ ಒಂದು ಸಂಗ್ರಹವನ್ನು ತೆಗೆದುಹಾಕಿ."
          }
        }
      }
    },
    "collection_missing" : {
      "comment": "@symbol collectionMissing\n@group SiriCollections\n@parameters ",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This collection is no longer available. Choose another saved collection."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह संग्रह अब उपलब्ध नहीं है। कोई दूसरा सहेजा गया संग्रह चुनें।"
