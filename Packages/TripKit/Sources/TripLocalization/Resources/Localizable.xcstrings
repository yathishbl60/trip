    "intent_set_visit_timing": {
      "comment": "Siri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Visit Timing"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "भ्रमण का समय तय करें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಭೇಟಿಯ ಸಮಯ ಹೊಂದಿಸಿ"
          }
        }
      }
    },
    "intent_set_visit_timing_description": {
      "comment": "Siri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates timing allowances or arrival for one saved place visit. Omitted values stay unchanged. It does not alter bookings or calculate travel estimates."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक सहेजी गई जगह के भ्रमण की अवधि या आगमन बदलता है। छोड़े गए मान नहीं बदलते। यह बुकिंग नहीं बदलता और यात्रा समय का अनुमान नहीं लगाता।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಒಂದು ಉಳಿಸಿದ ಸ್ಥಳ ಭೇಟಿಯ ಅವಧಿ ಅಥವಾ ಆಗಮನವನ್ನು ಬದಲಾಯಿಸುತ್ತದೆ. ಬಿಡಲಾದ ಮೌಲ್ಯಗಳು ಬದಲಾಗುವುದಿಲ್ಲ. ಇದು ಬುಕಿಂಗ್ ಬದಲಾಯಿಸುವುದಿಲ್ಲ ಅಥವಾ ಪ್ರಯಾಣದ ಅಂದಾಜು ಮಾಡುವುದಿಲ್ಲ."
          }
        }
      }
    },
    "intent_parameter_timed_visit": {
      "comment": "Siri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An existing place visit in an itinerary day, not a flight, stay, or reservation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा के दिन में मौजूद जगह का भ्रमण, उड़ान, ठहराव या आरक्षण नहीं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ವೇಳಾಪಟ್ಟಿಯ ದಿನದಲ್ಲಿ ಇರುವ ಸ್ಥಳ ಭೇಟಿ, ವಿಮಾನ, ವಾಸ್ತವ್ಯ ಅಥವಾ ಕಾಯ್ದಿರಿಸುವಿಕೆಯಲ್ಲ."
          }
        }
      }
    },
    "intent_parameter_visit_timing": {
      "comment": "Siri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the timing changes requested by the person. Minutes are whole numbers; arrival uses the itinerary day’s local time zone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "केवल व्यक्ति के माँगे गए समय बदलाव। मिनट पूर्ण संख्या में हैं; आगमन यात्रा के दिन के स्थानीय समय क्षेत्र में है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ವ್ಯಕ್ತಿ ಕೇಳಿದ ಸಮಯ ಬದಲಾವಣೆಗಳು ಮಾತ್ರ. ನಿಮಿಷಗಳು ಪೂರ್ಣ ಸಂಖ್ಯೆಗಳು; ಆಗಮನವು ವೇಳಾಪಟ್ಟಿಯ ದಿನದ ಸ್ಥಳೀಯ ಸಮಯ ವಲಯದಲ್ಲಿದೆ."
          }
        }
      }
    },
    "intent_timing_visit_minutes": {
      "comment": "Siri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes at the place, from 5 to 720. Leave empty to keep the saved duration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जगह पर बिताने के मिनट, 5 से 720। सहेजी अवधि रखने के लिए खाली छोड़ें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಸ್ಥಳದಲ್ಲಿ ಕಳೆಯುವ ನಿಮಿಷಗಳು, 5ರಿಂದ 720. ಉಳಿಸಿದ ಅವಧಿಯನ್ನು ಉಳಿಸಿಕೊಳ್ಳಲು ಖಾಲಿ ಬಿಡಿ."
          }
        }
      }
    },
    "intent_timing_travel_minutes": {
      "comment": "Siri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Travel allowance before the visit, from 0 to 720 minutes. Not a live estimate. Leave empty to keep it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "भ्रमण से पहले यात्रा के लिए 0 से 720 मिनट। यह लाइव अनुमान नहीं है। यथावत रखने के लिए खाली छोड़ें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಭೇಟಿಗೆ ಮೊದಲು ಪ್ರಯಾಣಕ್ಕೆ ಮೀಸಲಾದ 0ರಿಂದ 720 ನಿಮಿಷಗಳು. ನೇರ ಅಂದಾಜಲ್ಲ. ಬದಲಾಯಿಸದಿರಲು ಖಾಲಿ ಬಿಡಿ."
          }
        }
      }
    },
    "intent_timing_buffer_minutes": {
      "comment": "Siri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra allowance before the visit, from 0 to 180 minutes. Leave empty to keep it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "भ्रमण से पहले 0 से 180 अतिरिक्त मिनट। यथावत रखने के लिए खाली छोड़ें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಭೇಟಿಗೆ ಮೊದಲು ಹೆಚ್ಚುವರಿ 0ರಿಂದ 180 ನಿಮಿಷಗಳು. ಬದಲಾಯಿಸದಿರಲು ಖಾಲಿ ಬಿಡಿ."
          }
        }
      }
    },
    "intent_timing_arrival_clock": {
      "comment": "Siri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed arrival in 24-hour HH:mm form, such as 14:30, in the visit day’s time zone. Leave empty to keep it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "भ्रमण के दिन के समय क्षेत्र में 24-घंटे HH:mm रूप में तय आगमन, जैसे 14:30। यथावत रखने के लिए खाली छोड़ें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಭೇಟಿಯ ದಿನದ ಸಮಯ ವಲಯದಲ್ಲಿ 24-ಗಂಟೆಯ HH:mm ರೂಪದಲ್ಲಿ ನಿಗದಿತ ಆಗಮನ, ಉದಾಹರಣೆಗೆ 14:30. ಬದಲಾಯಿಸದಿರಲು ಖಾಲಿ ಬಿಡಿ."
          }
        }
      }
    },
    "intent_timing_next_day": {
      "comment": "Siri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "True only when the supplied arrival clock is on the day after the itinerary day. Otherwise false or empty."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "केवल तब सही जब दिया गया आगमन समय यात्रा के दिन के अगले दिन का हो। अन्यथा गलत या खाली।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ನೀಡಿದ ಆಗಮನದ ಸಮಯವು ವೇಳಾಪಟ್ಟಿಯ ದಿನದ ಮರುದಿನವಾಗಿದ್ದರೆ ಮಾತ್ರ ಸರಿ. ಇಲ್ಲದಿದ್ದರೆ ತಪ್ಪು ಅಥವಾ ಖಾಲಿ."
          }
        }
      }
    },
    "intent_timing_flexible_arrival": {
      "comment": "Siri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "True removes a fixed arrival. Do not also supply an arrival clock. False or empty keeps the existing setting."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सही होने पर तय आगमन हटाता है। साथ में आगमन समय न दें। गलत या खाली होने पर मौजूदा सेटिंग रहती है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಸರಿ ಎಂದರೆ ನಿಗದಿತ ಆಗಮನವನ್ನು ತೆಗೆದುಹಾಕುತ್ತದೆ. ಅದರೊಂದಿಗೆ ಆಗಮನದ ಸಮಯ ನೀಡಬೇಡಿ. ತಪ್ಪು ಅಥವಾ ಖಾಲಿ ಇದ್ದರೆ ಈಗಿನ ವ್ಯವಸ್ಥೆ ಉಳಿಯುತ್ತದೆ."
          }
        }
      }
    },
    "intent_parameter_draft_days": {
      "comment": "Siri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Number of days in the suggested draft, from 1 to 5. Existing plans change only after review and saving."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सुझाए गए मसौदे में दिनों की संख्या, 1 से 5। समीक्षा और सहेजने के बाद ही मौजूदा योजना बदलती है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಸೂಚಿತ ಕರಡಿನ ದಿನಗಳ ಸಂಖ್ಯೆ, 1ರಿಂದ 5. ಪರಿಶೀಲಿಸಿ ಉಳಿಸಿದ ನಂತರ ಮಾತ್ರ ಈಗಿನ ಯೋಜನೆ ಬದಲಾಗುತ್ತದೆ."
          }
        }
      }
    },
    "Set visit timing for ${place}": {
      "comment": "Siri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set visit timing for ${place}"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "${place} के भ्रमण का समय तय करें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "${place} ಭೇಟಿಯ ಸಮಯ ಹೊಂದಿಸಿ"
          }
        }
      }
    },
    "siri_timing_missing_visit": {
      "comment": "@symbol siriTimingMissingVisit\n@group Siri\n@parameters \nSiri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This saved place visit is no longer available. Choose a place in a trip day, not a booking."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह सहेजा गया जगह भ्रमण अब उपलब्ध नहीं है। यात्रा के दिन की जगह चुनें, बुकिंग नहीं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಈ ಉಳಿಸಿದ ಸ್ಥಳ ಭೇಟಿ ಈಗ ಲಭ್ಯವಿಲ್ಲ. ಪ್ರವಾಸದ ದಿನದ ಸ್ಥಳವನ್ನು ಆಯ್ಕೆಮಾಡಿ, ಬುಕಿಂಗ್ ಅಲ್ಲ."
          }
        }
      }
    },
    "siri_timing_empty_change": {
      "comment": "@symbol siriTimingEmptyChange\n@group Siri\n@parameters \nSiri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Specify a visit duration, travel allowance, buffer, or arrival change."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "भ्रमण की अवधि, यात्रा के मिनट, अतिरिक्त समय या आगमन में बदलाव बताएँ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಭೇಟಿಯ ಅವಧಿ, ಪ್ರಯಾಣದ ಸಮಯ, ಹೆಚ್ಚುವರಿ ಸಮಯ ಅಥವಾ ಆಗಮನದ ಬದಲಾವಣೆಯನ್ನು ತಿಳಿಸಿ."
          }
        }
      }
    },
    "siri_timing_invalid_minutes": {
      "comment": "@symbol siriTimingInvalidMinutes\n@group Siri\n@parameters \nSiri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 5–720 minutes for a visit, 0–720 for travel, and 0–180 for the buffer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "भ्रमण के लिए 5–720, यात्रा के लिए 0–720 और अतिरिक्त समय के लिए 0–180 मिनट रखें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಭೇಟಿಗೆ 5–720, ಪ್ರಯಾಣಕ್ಕೆ 0–720 ಮತ್ತು ಹೆಚ್ಚುವರಿ ಸಮಯಕ್ಕೆ 0–180 ನಿಮಿಷಗಳನ್ನು ಬಳಸಿ."
          }
        }
      }
    },
    "siri_timing_invalid_arrival": {
      "comment": "@symbol siriTimingInvalidArrival\n@group Siri\n@parameters \nSiri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a local arrival time in HH:mm form, such as 14:30."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्थानीय आगमन समय HH:mm रूप में दें, जैसे 14:30।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಸ್ಥಳೀಯ ಆಗಮನ ಸಮಯವನ್ನು HH:mm ರೂಪದಲ್ಲಿ ನೀಡಿ, ಉದಾಹರಣೆಗೆ 14:30."
          }
        }
      }
    },
    "siri_timing_conflicting_arrival": {
      "comment": "@symbol siriTimingConflictingArrival\n@group Siri\n@parameters \nSiri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose either a fixed or flexible arrival. A next-day arrival also needs a clock time."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तय या लचीला आगमन चुनें। अगले दिन के आगमन के लिए घड़ी का समय भी चाहिए।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ನಿಗದಿತ ಅಥವಾ ಹೊಂದಿಸಬಹುದಾದ ಆಗಮನವನ್ನು ಆಯ್ಕೆಮಾಡಿ. ಮರುದಿನದ ಆಗಮನಕ್ಕೆ ಗಡಿಯಾರದ ಸಮಯವೂ ಬೇಕು."
          }
        }
      }
    },
    "siri_timing_clock_needs_review": {
      "comment": "@symbol siriTimingClockNeedsReview\n@group Siri\n@parameters \nSiri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That local arrival time is missing or repeated during a time-zone change. Open the visit in Trip to review it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "समय क्षेत्र बदलने पर यह स्थानीय आगमन समय मौजूद नहीं है या दो बार आता है। समीक्षा के लिए Trip में भ्रमण खोलें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಸಮಯ ವಲಯ ಬದಲಾವಣೆಯಲ್ಲಿ ಆ ಸ್ಥಳೀಯ ಆಗಮನ ಸಮಯ ಇಲ್ಲ ಅಥವಾ ಎರಡು ಬಾರಿ ಬರುತ್ತದೆ. ಪರಿಶೀಲಿಸಲು Trip ನಲ್ಲಿ ಭೇಟಿಯನ್ನು ತೆರೆಯಿರಿ."
          }
        }
      }
    },
    "siri_timing_updated": {
      "comment": "@symbol siriTimingUpdated\n@group Siri\n@parameters String\nSiri visit timing input or outcome. Arrival is local to the saved itinerary day.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated visit timing for %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ के भ्रमण का समय अपडेट किया।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ಭೇಟಿಯ ಸಮಯವನ್ನು ನವೀಕರಿಸಲಾಗಿದೆ."
          }
        }
      }
    },
    "intent_saved_times": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved times"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सहेजे गए समय"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಉಳಿಸಿದ ಸಮಯಗಳು"
          }
        }
      }
    },
    "intent_open_checklist_description": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a saved trip’s packing and preparation checklist for review or manual editing."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "समीक्षा या संपादन के लिए सहेजी गई यात्रा की पैकिंग और तैयारी सूची खोलता है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪರಿಶೀಲನೆ ಅಥವಾ ಸಂಪಾದನೆಗಾಗಿ ಉಳಿಸಿದ ಪ್ರವಾಸದ ಪ್ಯಾಕಿಂಗ್ ಮತ್ತು ತಯಾರಿ ಪಟ್ಟಿಯನ್ನು ತೆರೆಯುತ್ತದೆ."
          }
        }
      }
    },
    "intent_open_saved_detail_description": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens one saved place, flight, stay, or reservation in its trip. It does not make a booking."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा में सहेजी गई जगह, उड़ान, ठहराव या आरक्षण खोलता है। यह बुकिंग नहीं करता।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರವಾಸದಲ್ಲಿ ಉಳಿಸಿದ ಸ್ಥಳ, ವಿಮಾನ, ವಾಸ್ತವ್ಯ ಅಥವಾ ಕಾಯ್ದಿರಿಸುವಿಕೆಯನ್ನು ತೆರೆಯುತ್ತದೆ. ಇದು ಬುಕಿಂಗ್ ಮಾಡುವುದಿಲ್ಲ."
          }
        }
      }
    },
    "intent_open_saved_trip_description": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the itinerary of an existing saved trip without changing its plans."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "मौजूदा सहेजी गई यात्रा की योजना बदले बिना उसका कार्यक्रम खोलता है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಈಗಾಗಲೇ ಉಳಿಸಿದ ಪ್ರವಾಸದ ಯೋಜನೆಯನ್ನು ಬದಲಾಯಿಸದೆ ಅದರ ವೇಳಾಪಟ್ಟಿಯನ್ನು ತೆರೆಯುತ್ತದೆ."
          }
        }
      }
    },
    "intent_parameter_saved_trip": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The existing saved trip. Distinguish trips with the same name by departure date."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "मौजूदा सहेजी गई यात्रा। एक जैसे नाम वाली यात्राओं को प्रस्थान की तारीख से पहचानें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಈಗಾಗಲೇ ಉಳಿಸಿದ ಪ್ರವಾಸ. ಒಂದೇ ಹೆಸರಿನ ಪ್ರವಾಸಗಳನ್ನು ಹೊರಡುವ ದಿನಾಂಕದಿಂದ ಗುರುತಿಸಿ."
          }
        }
      }
    },
    "intent_parameter_saved_detail": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One existing saved itinerary record, identified by its trip and day."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा और दिन से पहचाना जाने वाला एक मौजूदा सहेजा गया कार्यक्रम विवरण।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಅದರ ಪ್ರವಾಸ ಮತ್ತು ದಿನದಿಂದ ಗುರುತಿಸಲಾದ ಒಂದು ಉಳಿಸಿದ ವೇಳಾಪಟ್ಟಿ ವಿವರ."
          }
        }
      }
    },
    "intent_parameter_trip_date": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day to read in the trip’s time zone. Omit to use today."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा के समय क्षेत्र में पढ़ने वाला दिन। आज के लिए खाली छोड़ें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರವಾಸದ ಸಮಯ ವಲಯದಲ್ಲಿ ಓದಬೇಕಾದ ದಿನ. ಇಂದಿನ ದಿನಕ್ಕಾಗಿ ಖಾಲಿ ಬಿಡಿ."
          }
        }
      }
    },
    "intent_parameter_weather": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include available weather for that day only when requested. A forecast is not guaranteed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "माँगे जाने पर ही उस दिन का उपलब्ध मौसम शामिल करें। पूर्वानुमान मिलना निश्चित नहीं है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಕೇಳಿದಾಗ ಮಾತ್ರ ಆ ದಿನಕ್ಕೆ ಲಭ್ಯವಿರುವ ಹವಾಮಾನವನ್ನು ಸೇರಿಸಿ. ಮುನ್ಸೂಚನೆ ದೊರೆಯುವುದು ಖಚಿತವಲ್ಲ."
          }
        }
      }
    },
    "intent_parameter_preferences": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional travel or packing preferences stated by the person, up to 500 characters."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "व्यक्ति की बताई वैकल्पिक यात्रा या पैकिंग पसंद, अधिकतम 500 अक्षर।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ವ್ಯಕ್ತಿ ಹೇಳಿದ ಐಚ್ಛಿಕ ಪ್ರಯಾಣ ಅಥವಾ ಪ್ಯಾಕಿಂಗ್ ಆದ್ಯತೆಗಳು, ಗರಿಷ್ಠ 500 ಅಕ್ಷರಗಳು."
          }
        }
      }
    },
    "intent_parameter_processing": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use on-device processing unless the person explicitly chooses Private Cloud Compute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "व्यक्ति के स्पष्ट रूप से Private Cloud Compute चुनने पर ही उसका उपयोग करें; अन्यथा डिवाइस पर प्रोसेस करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ವ್ಯಕ್ತಿ ಸ್ಪಷ್ಟವಾಗಿ Private Cloud Compute ಆಯ್ಕೆ ಮಾಡಿದಾಗ ಮಾತ್ರ ಅದನ್ನು ಬಳಸಿ; ಇಲ್ಲದಿದ್ದರೆ ಸಾಧನದಲ್ಲೇ ಪ್ರಕ್ರಿಯೆಗೊಳಿಸಿ."
