    "intent_rename_trip_collection_description" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename an exact saved collection, preserving its identity and places. Repeating the same rename leaves its content unchanged."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सहेजे गए एक विशिष्ट संग्रह की पहचान और जगहें बनाए रखते हुए उसका नाम बदलें। वही नाम दोबारा रखने पर उसकी सामग्री नहीं बदलती।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಉಳಿಸಿದ ನಿರ್ದಿಷ್ಟ ಸಂಗ್ರಹದ ಗುರುತು ಮತ್ತು ಸ್ಥಳಗಳನ್ನು ಉಳಿಸಿಕೊಂಡು ಅದರ ಹೆಸರು ಬದಲಿಸಿ. ಅದೇ ಹೆಸರನ್ನು ಮತ್ತೆ ನೀಡಿದರೆ ಅದರ ವಿಷಯ ಬದಲಾಗುವುದಿಲ್ಲ."
          }
        }
      }
    },
    "intent_review_booking_alarm" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review Saved Booking Alarm"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सहेजी गई बुकिंग के अलार्म की समीक्षा करें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಉಳಿಸಿದ ಬುಕಿಂಗ್ ಅಲಾರಂ ಪರಿಶೀಲಿಸಿ"
          }
        }
      }
    },
    "intent_review_booking_alarm_description" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the alarm review for an exact saved booking in Trip. Choose or change the alarm time and confirm in the app; running this action does not schedule an alarm. Available on iPhone and iPad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trip में सहेजी गई सटीक बुकिंग के अलार्म की समीक्षा खोलें। ऐप में अलार्म का समय चुनें या बदलें और पुष्टि करें; यह कार्रवाई चलाने से अलार्म सेट नहीं होता। iPhone और iPad पर उपलब्ध।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trip ನಲ್ಲಿ ನಿಖರವಾದ ಉಳಿಸಿದ ಬುಕಿಂಗ್‌ನ ಅಲಾರಂ ಪರಿಶೀಲನೆ ತೆರೆಯಿರಿ. ಆ್ಯಪ್‌ನಲ್ಲಿ ಅಲಾರಂ ಸಮಯ ಆಯ್ಕೆಮಾಡಿ ಅಥವಾ ಬದಲಿಸಿ ದೃಢೀಕರಿಸಿ; ಈ ಕ್ರಿಯೆ ನಡೆಸುವುದರಿಂದ ಅಲಾರಂ ನಿಗದಿಯಾಗುವುದಿಲ್ಲ. iPhone ಮತ್ತು iPad ನಲ್ಲಿ ಲಭ್ಯ."
          }
        }
      }
    },
    "intent_save_trip_place_to_collection" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Trip Place to Collection"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा की जगह संग्रह में सहेजें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರವಾಸದ ಸ್ಥಳವನ್ನು ಸಂಗ್ರಹದಲ್ಲಿ ಉಳಿಸಿ"
          }
        }
      }
    },
    "intent_save_trip_place_to_collection_description" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save an exact existing itinerary place into a saved collection without moving its original visit. Repeated saves keep one copy of the place. Does not copy visit timing or private notes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा कार्यक्रम की एक विशिष्ट मौजूदा जगह को सहेजे गए संग्रह में सहेजें, उसे मूल दिन के कार्यक्रम से हटाए बिना। बार-बार सहेजने पर भी जगह की एक ही प्रति रहती है। जगह पर जाने की समय-सारणी या निजी नोट्स कॉपी नहीं होते।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರವಾಸದ ಯೋಜನೆಯಲ್ಲಿರುವ ನಿರ್ದಿಷ್ಟ ಸ್ಥಳವನ್ನು ಅದರ ಮೂಲ ಭೇಟಿಯನ್ನು ಸರಿಸದೆ ಉಳಿಸಿದ ಸಂಗ್ರಹಕ್ಕೆ ಸೇರಿಸಿ. ಮತ್ತೆ ಮತ್ತೆ ಉಳಿಸಿದರೂ ಸ್ಥಳದ ಒಂದೇ ಪ್ರತಿ ಉಳಿಯುತ್ತದೆ. ಭೇಟಿಯ ಸಮಯ ಅಥವಾ ಖಾಸಗಿ ಟಿಪ್ಪಣಿಗಳನ್ನು ನಕಲಿಸುವುದಿಲ್ಲ."
          }
        }
      }
    },
    "intent_saved_collection" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved trip collection"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सहेजी गई यात्रा का संग्रह"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಉಳಿಸಿದ ಪ್ರವಾಸದ ಸಂಗ್ರಹ"
          }
        }
      }
    },
    "siri_move_changed" : {
      "comment": "@symbol siriMoveChanged\n@group SiriCoverage\n@parameters ",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This place changed while the move was saving. Open Trip to review its current day before trying again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्थान को दूसरे दिन ले जाना सहेजते समय यह स्थान बदल गया। दोबारा कोशिश करने से पहले Trip में इसका मौजूदा दिन देखें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಸರಿಸುವ ಬದಲಾವಣೆಯನ್ನು ಉಳಿಸುವಾಗ ಈ ಸ್ಥಳ ಬದಲಾಗಿದೆ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸುವ ಮೊದಲು Trip ನಲ್ಲಿ ಅದರ ಪ್ರಸ್ತುತ ದಿನವನ್ನು ಪರಿಶೀಲಿಸಿ."
          }
        }
      }
    },
    "siri_move_duplicate" : {
      "comment": "@symbol siriMoveDuplicate\n@group SiriCoverage\n@parameters ",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That place is already saved on the destination day. Choose another day or review the itinerary in Trip."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वह स्थान गंतव्य दिन में पहले से सहेजा गया है। दूसरा दिन चुनें या Trip में यात्रा कार्यक्रम की समीक्षा करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಆ ಸ್ಥಳವನ್ನು ಗುರಿ ದಿನದಲ್ಲಿ ಈಗಾಗಲೇ ಉಳಿಸಲಾಗಿದೆ. ಬೇರೆ ದಿನವನ್ನು ಆಯ್ಕೆಮಾಡಿ ಅಥವಾ Trip ನಲ್ಲಿ ಪ್ರವಾಸದ ವೇಳಾಪಟ್ಟಿಯನ್ನು ಪರಿಶೀಲಿಸಿ."
          }
        }
      }
    },
    "siri_move_full" : {
      "comment": "@symbol siriMoveFull\n@group SiriCoverage\n@parameters ",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The destination day is full. Remove a place in Trip or choose another day."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "गंतव्य दिन भर गया है। Trip में कोई स्थान हटाएँ या दूसरा दिन चुनें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಗುರಿ ದಿನ ತುಂಬಿದೆ. Trip ನಲ್ಲಿ ಒಂದು ಸ್ಥಳವನ್ನು ತೆಗೆದುಹಾಕಿ ಅಥವಾ ಬೇರೆ ದಿನ ಆಯ್ಕೆಮಾಡಿ."
          }
        }
      }
    },
    "siri_moved_visit" : {
      "comment": "@symbol siriMovedVisit\n@group SiriCoverage\n@parameters String,String",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved %@ to day %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ को दिन %@ में ले जाया गया।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ಅನ್ನು ದಿನ %@ ಕ್ಕೆ ಸರಿಸಲಾಗಿದೆ."
          }
        }
      }
    }
  },
  "version" : "1.1"
