    "travel_calendar_eligible_only": {
      "comment": "@symbol calendarEligibleOnly\n@group NativeTravel\n@parameters \nCalendar, Reminders, or travel alarm system action UI.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookings need confirmed start and end times with reviewed time zones. Edit a booking to complete its schedule."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बुकिंग के लिए पुष्टि किए गए आरंभ और अंत समय तथा जाँचे गए समय क्षेत्र चाहिए। समय पूरा करने के लिए बुकिंग संपादित करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಬುಕಿಂಗ್‌ಗಳಿಗೆ ದೃಢೀಕರಿಸಿದ ಪ್ರಾರಂಭ ಮತ್ತು ಅಂತ್ಯ ಸಮಯಗಳು ಹಾಗೂ ಪರಿಶೀಲಿಸಿದ ಸಮಯ ವಲಯಗಳು ಬೇಕು. ವೇಳಾಪಟ್ಟಿ ಪೂರ್ಣಗೊಳಿಸಲು ಬುಕಿಂಗ್ ಸಂಪಾದಿಸಿ."
          }
        }
      }
    },
    "travel_calendar_export_explanation": {
      "comment": "@symbol calendarExportExplanation\n@group NativeTravel\n@parameters \nCalendar, Reminders, or travel alarm system action UI.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only bookings with confirmed start and end times appear. Previously exported bookings are skipped. Changes in Trip or Calendar are not synchronized; edit exported events in Calendar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "केवल पुष्टि किए गए आरंभ और अंत समय वाली बुकिंग दिखाई जाती हैं। पहले निर्यात की गई बुकिंग छोड़ दी जाती हैं। Trip या कैलेंडर के बदलाव सिंक नहीं होते; निर्यात किए गए इवेंट कैलेंडर में संपादित करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ದೃಢೀಕರಿಸಿದ ಪ್ರಾರಂಭ ಮತ್ತು ಅಂತ್ಯ ಸಮಯಗಳಿರುವ ಬುಕಿಂಗ್‌ಗಳು ಮಾತ್ರ ಕಾಣಿಸುತ್ತವೆ. ಹಿಂದೆ ರಫ್ತು ಮಾಡಿದ ಬುಕಿಂಗ್‌ಗಳನ್ನು ಬಿಡಲಾಗುತ್ತದೆ. Trip ಅಥವಾ ಕ್ಯಾಲೆಂಡರ್‌ನ ಬದಲಾವಣೆಗಳು ಸಿಂಕ್ ಆಗುವುದಿಲ್ಲ; ರಫ್ತು ಮಾಡಿದ ಈವೆಂಟ್‌ಗಳನ್ನು ಕ್ಯಾಲೆಂಡರ್‌ನಲ್ಲಿ ಸಂಪಾದಿಸಿ."
          }
        }
      }
    },
    "travel_no_pending_reminders": {
      "comment": "@symbol noPendingReminders\n@group NativeTravel\n@parameters \nCalendar, Reminders, or travel alarm system action UI.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No incomplete checklist items"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "चेकलिस्ट में कोई अधूरा आइटम नहीं है"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪರಿಶೀಲನಾಪಟ್ಟಿಯಲ್ಲಿ ಅಪೂರ್ಣ ಅಂಶಗಳಿಲ್ಲ"
          }
        }
      }
    },
    "travel_reminder_export_explanation": {
      "comment": "@symbol reminderExportExplanation\n@group NativeTravel\n@parameters \nCalendar, Reminders, or travel alarm system action UI.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add selected incomplete items to your default Reminders list. Previously exported items are skipped. Completion and edits are not synchronized with Trip."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "चुने गए अधूरे आइटम अपनी डिफ़ॉल्ट रिमाइंडर सूची में जोड़ें। पहले निर्यात किए गए आइटम छोड़ दिए जाते हैं। पूर्णता और बदलाव Trip के साथ सिंक नहीं होते।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಆಯ್ಕೆ ಮಾಡಿದ ಅಪೂರ್ಣ ಅಂಶಗಳನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ರಿಮೈಂಡರ್ ಪಟ್ಟಿಗೆ ಸೇರಿಸಿ. ಹಿಂದೆ ರಫ್ತು ಮಾಡಿದ ಅಂಶಗಳನ್ನು ಬಿಡಲಾಗುತ್ತದೆ. ಪೂರ್ಣಗೊಳಿಸುವಿಕೆ ಮತ್ತು ಸಂಪಾದನೆಗಳು Trip ಜೊತೆ ಸಿಂಕ್ ಆಗುವುದಿಲ್ಲ."
          }
        }
      }
    },
    "travel_add_reminder_due_date": {
