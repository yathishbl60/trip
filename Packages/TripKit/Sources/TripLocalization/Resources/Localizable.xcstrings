    },
    "intent_property_saved_buffer_minutes" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved personal buffer allowance in minutes before a place. Missing for bookings or older snapshots without timing."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्थान पर पहुँचने से पहले सहेजा गया निजी अतिरिक्त समय, मिनटों में। बुकिंग या समय के बिना पुराने स्नैपशॉट के लिए उपलब्ध नहीं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಸ್ಥಳಕ್ಕೆ ತಲುಪುವ ಮುನ್ನ ಉಳಿಸಿದ ವೈಯಕ್ತಿಕ ಹೆಚ್ಚುವರಿ ಸಮಯ, ನಿಮಿಷಗಳಲ್ಲಿ. ಬುಕಿಂಗ್‌ಗಳು ಅಥವಾ ಸಮಯವಿಲ್ಲದ ಹಳೆಯ ಮಾಹಿತಿಗೆ ಲಭ್ಯವಿಲ್ಲ."
          }
        }
      }
    },
    "intent_property_saved_travel_minutes" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved personal travel allowance in minutes before a place, not a route estimate or live travel time. Missing for bookings or older snapshots without timing."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्थान पर पहुँचने से पहले यात्रा के लिए सहेजा गया निजी समय, मिनटों में। यह मार्ग का अनुमान या लाइव यात्रा समय नहीं है। बुकिंग या समय के बिना पुराने स्नैपशॉट के लिए उपलब्ध नहीं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಸ್ಥಳಕ್ಕೆ ತಲುಪುವ ಮುನ್ನ ಪ್ರಯಾಣಕ್ಕಾಗಿ ಉಳಿಸಿದ ವೈಯಕ್ತಿಕ ಸಮಯ, ನಿಮಿಷಗಳಲ್ಲಿ. ಇದು ಮಾರ್ಗದ ಅಂದಾಜು ಅಥವಾ ನೇರ ಪ್ರಯಾಣದ ಸಮಯವಲ್ಲ. ಬುಕಿಂಗ್‌ಗಳು ಅಥವಾ ಸಮಯವಿಲ್ಲದ ಹಳೆಯ ಮಾಹಿತಿಗೆ ಲಭ್ಯವಿಲ್ಲ."
          }
        }
      }
    },
    "intent_property_saved_visit_minutes" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved visit duration in minutes for a place. Missing for bookings or older snapshots without timing; never infer a duration from missing data."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "किसी स्थान पर ठहरने की सहेजी गई अवधि, मिनटों में। बुकिंग या समय के बिना पुराने स्नैपशॉट के लिए उपलब्ध नहीं; जानकारी न होने पर अवधि का अनुमान न लगाएँ।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಸ್ಥಳದಲ್ಲಿ ಕಳೆಯಲು ಉಳಿಸಿದ ಅವಧಿ, ನಿಮಿಷಗಳಲ್ಲಿ. ಬುಕಿಂಗ್‌ಗಳು ಅಥವಾ ಸಮಯವಿಲ್ಲದ ಹಳೆಯ ಮಾಹಿತಿಗೆ ಲಭ್ಯವಿಲ್ಲ; ಮಾಹಿತಿ ಇಲ್ಲದಾಗ ಅವಧಿಯನ್ನು ಊಹಿಸಬೇಡಿ."
          }
        }
      }
    },
    "intent_read_trip_collection" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Trip Collection"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
