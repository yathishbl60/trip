          }
        }
      }
    },
    "intent_move_saved_visit_description" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move an exact saved place to the end of another day in the same trip. Preserve its notes, visit duration, travel and buffer allowances, and local arrival clock on the destination day. Does not move bookings, change reservations, or calculate routes. Repeating the same destination leaves the visit unchanged."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "किसी सहेजे गए स्थान को उसी यात्रा के दूसरे दिन के अंत में ले जाएँ। उसके नोट्स, घूमने की अवधि, यात्रा और अतिरिक्त समय तथा गंतव्य दिन का स्थानीय आगमन समय बनाए रखें। बुकिंग या आरक्षण नहीं बदलता और मार्गों की गणना नहीं करता। वही गंतव्य दोहराने पर स्थान अपरिवर्तित रहता है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ನಿಖರವಾದ ಉಳಿಸಿದ ಸ್ಥಳವನ್ನು ಅದೇ ಪ್ರವಾಸದ ಮತ್ತೊಂದು ದಿನದ ಕೊನೆಗೆ ಸರಿಸಿ. ಅದರ ಟಿಪ್ಪಣಿಗಳು, ಭೇಟಿಯ ಅವಧಿ, ಪ್ರಯಾಣ ಮತ್ತು ಹೆಚ್ಚುವರಿ ಸಮಯ ಹಾಗೂ ಗುರಿ ದಿನದ ಸ್ಥಳೀಯ ಆಗಮನದ ಸಮಯವನ್ನು ಉಳಿಸುತ್ತದೆ. ಬುಕಿಂಗ್‌ಗಳು ಅಥವಾ ಕಾಯ್ದಿರಿಸುವಿಕೆಗಳನ್ನು ಬದಲಿಸುವುದಿಲ್ಲ, ಮಾರ್ಗಗಳನ್ನು ಲೆಕ್ಕಿಸುವುದಿಲ್ಲ. ಅದೇ ಗುರಿಯನ್ನು ಪುನರಾವರ್ತಿಸಿದರೆ ಭೇಟಿ ಬದಲಾಗುವುದಿಲ್ಲ."
          }
        }
      }
    },
    "intent_parameter_alarm_booking" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a saved flight, train, stay, reservation, or other booking from Trip. Saved place visits do not have booking alarms."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trip से सहेजी गई उड़ान, ट्रेन, ठहराव, आरक्षण या दूसरी बुकिंग चुनें। सहेजे गए स्थानों की यात्राओं के लिए बुकिंग अलार्म नहीं होते।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trip ನಿಂದ ಉಳಿಸಿದ ವಿಮಾನ, ರೈಲು, ತಂಗುವಿಕೆ, ಕಾಯ್ದಿರಿಸುವಿಕೆ ಅಥವಾ ಇತರ ಬುಕಿಂಗ್ ಆಯ್ಕೆಮಾಡಿ. ಉಳಿಸಿದ ಸ್ಥಳದ ಭೇಟಿಗಳಿಗೆ ಬುಕಿಂಗ್ ಅಲಾರಂ ಇರುವುದಿಲ್ಲ."
          }
        }
      }
    },
    "intent_parameter_collection_name" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A collection name of 1 to 80 characters. Leading and trailing spaces are removed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 से 80 वर्णों का संग्रह नाम। शुरू और अंत के खाली स्थान हटा दिए जाते हैं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1 ರಿಂದ 80 ಅಕ್ಷರಗಳ ಸಂಗ್ರಹದ ಹೆಸರು. ಆರಂಭ ಮತ್ತು ಕೊನೆಯ ಖಾಲಿ ಜಾಗಗಳನ್ನು ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ."
          }
        }
      }
    },
    "intent_parameter_collection_source_visit" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An exact saved itinerary place to copy into the collection. Bookings are not places. Its original visit stays in its day."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "संग्रह में कॉपी करने के लिए यात्रा कार्यक्रम में सहेजी गई एक विशिष्ट जगह। बुकिंग जगहें नहीं हैं। उस जगह को मूल दिन के कार्यक्रम से हटाया नहीं जाता।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಸಂಗ್ರಹಕ್ಕೆ ನಕಲಿಸಲು ಪ್ರವಾಸದ ಯೋಜನೆಯಲ್ಲಿ ಉಳಿಸಿದ ನಿರ್ದಿಷ್ಟ ಸ್ಥಳ. ಬುಕಿಂಗ್‌ಗಳು ಸ್ಥಳಗಳಲ್ಲ. ಅದರ ಮೂಲ ಭೇಟಿ ಅದೇ ದಿನದಲ್ಲಿ ಉಳಿಯುತ್ತದೆ."
          }
        }
      }
    },
    "intent_parameter_destination_day" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The existing destination day number in the same saved trip. Ask if the intended day is unclear."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "उसी सहेजी गई यात्रा में मौजूदा गंतव्य दिन की संख्या। इच्छित दिन अस्पष्ट हो तो पूछें।"
