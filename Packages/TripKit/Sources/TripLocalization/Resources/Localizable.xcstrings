    },
    "intent_open_trip_tool_description": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open trip editing or a Calendar or Reminders export review. The person reviews and confirms changes in Trip; opening a review does not export anything."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा संपादन या Calendar अथवा Reminders निर्यात समीक्षा खोलें। व्यक्ति Trip में बदलावों की समीक्षा और पुष्टि करता है; समीक्षा खोलने से निर्यात नहीं होता।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರವಾಸ ಸಂಪಾದನೆ ಅಥವಾ Calendar ಅಥವಾ Reminders ರಫ್ತು ಪರಿಶೀಲನೆ ತೆರೆಯಿರಿ. ಬಳಕೆದಾರರು Trip ನಲ್ಲಿ ಬದಲಾವಣೆಗಳನ್ನು ಪರಿಶೀಲಿಸಿ ದೃಢೀಕರಿಸುತ್ತಾರೆ; ಪರಿಶೀಲನೆ ತೆರೆಯುವುದರಿಂದ ರಫ್ತು ಆಗುವುದಿಲ್ಲ."
          }
        }
      }
    },
    "intent_parameter_day_tool": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the map, directions, a stop-order suggestion, schedule editing, planning preview, weather, or adding places for the specified itinerary day."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "निर्दिष्ट यात्रा-दिन के लिए नक्शा, रास्ते, स्थानों के क्रम का सुझाव, समय-सारणी संपादन, योजना पूर्वावलोकन, मौसम या स्थान जोड़ना चुनें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ನಿರ್ದಿಷ್ಟ ಪ್ರವಾಸದ ದಿನಕ್ಕೆ ನಕ್ಷೆ, ದಿಕ್ಕುಗಳು, ಸ್ಥಳಗಳ ಕ್ರಮದ ಸಲಹೆ, ವೇಳಾಪಟ್ಟಿ ಸಂಪಾದನೆ, ಯೋಜನೆಯ ಪೂರ್ವವೀಕ್ಷಣೆ, ಹವಾಮಾನ ಅಥವಾ ಸ್ಥಳಗಳನ್ನು ಸೇರಿಸುವುದನ್ನು ಆಯ್ಕೆಮಾಡಿ."
          }
        }
      }
    },
    "intent_parameter_new_trip_days": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number of itinerary days to create, from 1 to 30."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा योजना में बनाने वाले दिनों की संख्या, 1 से 30।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ರಚಿಸಬೇಕಾದ ಪ್ರವಾಸದ ದಿನಗಳ ಸಂಖ್ಯೆ, 1 ರಿಂದ 30."
          }
        }
      }
    },
    "intent_parameter_new_trip_departure": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The departure date for the new trip, using the device’s current calendar and time zone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नई यात्रा की प्रस्थान तिथि, डिवाइस के वर्तमान कैलेंडर और समय क्षेत्र के अनुसार।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಸಾಧನದ ಪ್ರಸ್ತುತ ಕ್ಯಾಲೆಂಡರ್ ಮತ್ತು ಸಮಯ ವಲಯದ ಪ್ರಕಾರ ಹೊಸ ಪ್ರವಾಸದ ನಿರ್ಗಮನ ದಿನಾಂಕ."
          }
        }
      }
    },
    "intent_parameter_new_trip_name": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name for the new saved trip, from 1 to 80 characters."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नई सहेजी यात्रा का नाम, 1 से 80 अक्षर।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಹೊಸ ಉಳಿಸಿದ ಪ್ರವಾಸದ ಹೆಸರು, 1 ರಿಂದ 80 ಅಕ್ಷರಗಳು."
          }
        }
      }
    },
    "intent_parameter_section": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The section of the saved trip to open."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सहेजी गई यात्रा का वह भाग जिसे खोलना है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ತೆರೆಯಬೇಕಾದ ಉಳಿಸಿದ ಪ್ರವಾಸದ ವಿಭಾಗ."
          }
        }
      }
    },
    "intent_parameter_trip_tool": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit trip details, or review exporting saved bookings to Calendar or incomplete checklist items to Reminders."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा विवरण संपादित करें या सहेजी बुकिंग Calendar में अथवा अधूरे चेकलिस्ट आइटम Reminders में निर्यात करने की समीक्षा करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರವಾಸ ವಿವರ ಸಂಪಾದಿಸಿ, ಅಥವಾ ಉಳಿಸಿದ ಬುಕಿಂಗ್‌ಗಳನ್ನು Calendar ಗೆ ಅಥವಾ ಅಪೂರ್ಣ ಪರಿಶೀಲನಾ ಅಂಶಗಳನ್ನು Reminders ಗೆ ರಫ್ತು ಮಾಡುವುದನ್ನು ಪರಿಶೀಲಿಸಿ."
          }
        }
      }
    },
    "intent_trip_section": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
