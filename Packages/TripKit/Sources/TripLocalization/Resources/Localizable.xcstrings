    "collection_needs_saved_visit" : {
      "comment": "@symbol collectionNeedsSavedVisit\n@group SiriCollections\n@parameters ",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a place that is still saved in a trip day. Bookings cannot be saved as collection places."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ऐसी जगह चुनें जो यात्रा के किसी दिन में अभी भी सहेजी हुई है। बुकिंग को संग्रह की जगहों के रूप में नहीं सहेजा जा सकता।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರವಾಸದ ಯಾವುದಾದರೂ ದಿನದಲ್ಲಿ ಇನ್ನೂ ಉಳಿಸಿರುವ ಸ್ಥಳವನ್ನು ಆಯ್ಕೆಮಾಡಿ. ಬುಕಿಂಗ್‌ಗಳನ್ನು ಸಂಗ್ರಹದ ಸ್ಥಳಗಳಾಗಿ ಉಳಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        }
      }
    },
    "collection_places_full" : {
      "comment": "@symbol collectionPlacesFull\n@group SiriCollections\n@parameters ",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This collection is full. Remove a saved place in Trip before adding another."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह संग्रह भर गया है। दूसरी जगह जोड़ने से पहले Trip में कोई सहेजी गई जगह हटाएँ।"
          }
