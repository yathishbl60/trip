    },
    "intent_property_collection_place_count" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number of places currently saved in this collection, whether or not they are on an itinerary day."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस संग्रह में अभी सहेजी गई जगहों की संख्या, चाहे वे यात्रा के किसी दिन के कार्यक्रम में हों या नहीं।"
