            "value": "ಪ್ಯಾಕಿಂಗ್ ಪೂರ್ವನಿಗದಿ"
          }
        }
      }
    },
    "intent_new_event_kind": {
      "comment": "Siri preparation action. A new booking draft needs explicit in-app review and saving.",
