    "travel_booking_time_review_explanation": {
      "comment": "@symbol bookingTimeReviewExplanation\n@group NativeTravel\n@parameters \nBooking document import and reviewed extraction.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No time is selected automatically. Choose a detected time only after checking it, and confirm its time zone. Other date formats can be entered in the booking editor."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कोई समय अपने आप नहीं चुना जाता। जाँच के बाद ही पहचाना गया समय चुनें और उसका समय क्षेत्र पक्का करें। अन्य तारीख प्रारूप बुकिंग संपादक में दर्ज किए जा सकते हैं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಯಾವುದೇ ಸಮಯವನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಆಯ್ಕೆಮಾಡುವುದಿಲ್ಲ. ಪರಿಶೀಲಿಸಿದ ನಂತರವೇ ಗುರುತಿಸಿದ ಸಮಯವನ್ನು ಆಯ್ಕೆಮಾಡಿ ಮತ್ತು ಅದರ ಸಮಯ ವಲಯವನ್ನು ದೃಢಪಡಿಸಿ. ಇತರ ದಿನಾಂಕ ಸ್ವರೂಪಗಳನ್ನು ಬುಕಿಂಗ್ ಸಂಪಾದಕದಲ್ಲಿ ನಮೂದಿಸಬಹುದು."
          }
        }
      }
