    "plan_up_to24_saved_places_choosing_private_cloud" : {
      "comment" : "@symbol planUpTo24SavedPlacesChoosingPrivateCloud\n@group Intents\n@parameters \ntrip/App/Intents/DraftTripItineraryIntent.swift",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan up to 24 saved places. Choosing Private Cloud Compute sends selected places, coordinates, and preferences to Apple. Review before saving."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "24 सहेजे गए स्थानों तक की योजना बनाएं। प्राइवेट क्लाउड कंप्यूट चुनने से चयनित स्थान, निर्देशांक और प्राथमिकताएँ Apple को भेज दी जाती हैं। सहेजने से पहले समीक्षा करें."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಉಳಿಸಿದ 24 ಸ್ಥಳಗಳವರೆಗೆ ಯೋಜನೆ ಮಾಡಿ. ಖಾಸಗಿ ಕ್ಲೌಡ್ ಕಂಪ್ಯೂಟ್ ಅನ್ನು ಆರಿಸುವುದರಿಂದ ಆಯ್ದ ಸ್ಥಳಗಳು, ನಿರ್ದೇಶಾಂಕಗಳು ಮತ್ತು ಆದ್ಯತೆಗಳನ್ನು Apple ಗೆ ಕಳುಹಿಸುತ್ತದೆ. ಉಳಿಸುವ ಮೊದಲು ಪರಿಶೀಲಿಸಿ."
          }
        }
      }
    },
