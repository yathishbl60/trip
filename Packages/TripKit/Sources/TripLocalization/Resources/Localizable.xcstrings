    "intent_read_trip_collection_description" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the current names of places saved in a collection, including unscheduled places. Returns the saved names in order and speaks the first three. Does not include private notes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "संग्रह में अभी सहेजी गई जगहों के नाम पढ़ें, उन जगहों सहित जिन्हें किसी दिन के लिए तय नहीं किया गया है। सहेजे गए नाम क्रम में लौटाता है और पहले तीन नाम बोलता है। निजी नोट्स शामिल नहीं हैं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಯಾವುದೇ ದಿನಕ್ಕೆ ನಿಗದಿಪಡಿಸದ ಸ್ಥಳಗಳನ್ನೂ ಒಳಗೊಂಡಂತೆ, ಸಂಗ್ರಹದಲ್ಲಿ ಪ್ರಸ್ತುತ ಉಳಿಸಿದ ಸ್ಥಳಗಳ ಹೆಸರುಗಳನ್ನು ಓದಿ. ಉಳಿಸಿದ ಹೆಸರುಗಳನ್ನು ಕ್ರಮವಾಗಿ ಹಿಂತಿರುಗಿಸುತ್ತದೆ ಮತ್ತು ಮೊದಲ ಮೂರು ಹೆಸರುಗಳನ್ನು ಹೇಳುತ್ತದೆ. ಖಾಸಗಿ ಟಿಪ್ಪಣಿಗಳನ್ನು ಒಳಗೊಂಡಿಲ್ಲ."
          }
        }
      }
    },
