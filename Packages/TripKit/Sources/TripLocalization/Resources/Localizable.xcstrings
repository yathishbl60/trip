        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಈ ಸ್ಥಳಗಳನ್ನು ಸರಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಪುನರಾವರ್ತಿತ ಸ್ಥಳಗಳು, ತುಂಬಿರುವ ದಿನ ಅಥವಾ ನಿಗದಿತ ಆಗಮನ ಸಮಯಗಳನ್ನು ಪರಿಶೀಲಿಸಿ, ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        }
      }
    },
