    "intent_parameter_saved_collection" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An exact saved collection in a trip. Resolve it from the current saved library."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा में सहेजा गया एक विशिष्ट संग्रह। इसे अभी सहेजी गई लाइब्रेरी से पहचानें।"
          }
