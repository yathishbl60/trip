      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use on-device Apple Intelligence to find saved stays, transport, reservations, places, or times. Returns saved records and a spoken summary; requires Apple Intelligence."
          }
