        }
      }
    },
    "siri_visit_not_next": {
      "comment": "@symbol siriVisitNotNext\n@group Siri\n@parameters \nSiri saved-place actions. Navigation and visit tracking remain separate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That place is not next in your tracked trip day. Open Trip to check the day and visit order."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वह जगह आपके ट्रैक किए यात्रा दिन में अगली नहीं है। दिन और भ्रमण क्रम देखने के लिए Trip खोलें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಆ ಸ್ಥಳವು ಟ್ರ್ಯಾಕ್ ಮಾಡುತ್ತಿರುವ ಪ್ರವಾಸದ ದಿನದಲ್ಲಿ ಮುಂದಿನದು ಅಲ್ಲ. ದಿನ ಮತ್ತು ಭೇಟಿಯ ಕ್ರಮ ಪರಿಶೀಲಿಸಲು Trip ತೆರೆಯಿರಿ."
          }
        }
      }
    },
    "siri_visit_no_location": {
      "comment": "@symbol siriVisitNoLocation\n@group Siri\n@parameters \nSiri saved-place actions. Navigation and visit tracking remain separate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This saved place has no usable map location. Open Trip to review it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस सहेजी जगह का उपयोग योग्य मानचित्र स्थान नहीं है। समीक्षा के लिए Trip खोलें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಈ ಉಳಿಸಿದ ಸ್ಥಳಕ್ಕೆ ಬಳಸಬಹುದಾದ ನಕ್ಷೆ ಸ್ಥಾನವಿಲ್ಲ. ಪರಿಶೀಲಿಸಲು Trip ತೆರೆಯಿರಿ."
          }
        }
      }
    },
