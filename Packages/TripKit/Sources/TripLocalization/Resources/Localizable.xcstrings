        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಅದೇ ಉಳಿಸಿದ ಪ್ರವಾಸದಲ್ಲಿರುವ ಗುರಿ ದಿನದ ಸಂಖ್ಯೆ. ಉದ್ದೇಶಿತ ದಿನ ಸ್ಪಷ್ಟವಿಲ್ಲದಿದ್ದರೆ ಕೇಳಿ."
