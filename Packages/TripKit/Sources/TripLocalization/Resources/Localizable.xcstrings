    "intent_alarm_saved_booking_required" : {
      "comment": "@symbol chooseSavedBookingForAlarm\n@group SiriCoverage\n@parameters ",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a saved booking to review its alarm. Saved place visits do not have booking alarms."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अलार्म की समीक्षा के लिए सहेजी गई बुकिंग चुनें। सहेजे गए स्थानों की यात्राओं के लिए बुकिंग अलार्म नहीं होते।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಅಲಾರಂ ಪರಿಶೀಲಿಸಲು ಉಳಿಸಿದ ಬುಕಿಂಗ್ ಆಯ್ಕೆಮಾಡಿ. ಉಳಿಸಿದ ಸ್ಥಳದ ಭೇಟಿಗಳಿಗೆ ಬುಕಿಂಗ್ ಅಲಾರಂ ಇರುವುದಿಲ್ಲ."
          }
        }
      }
    },
