    "intent_create_trip_collection" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create Trip Collection"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा संग्रह बनाएँ"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರವಾಸದ ಸಂಗ್ರಹ ರಚಿಸಿ"
          }
        }
      }
    },
    "intent_create_trip_collection_description" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a named saved-place collection in a saved trip. If one collection already has the same normalized name, return it without creating a duplicate. Does not add places or change the itinerary."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सहेजी गई यात्रा में सहेजी गई जगहों का एक नाम वाला संग्रह बनाएँ। यदि उसी मानकीकृत नाम का एक संग्रह पहले से है, तो दूसरा बनाने के बजाय वही लौटाएँ। इससे जगहें नहीं जुड़तीं और यात्रा कार्यक्रम नहीं बदलता।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಉಳಿಸಿದ ಪ್ರವಾಸದಲ್ಲಿ ಉಳಿಸಿದ ಸ್ಥಳಗಳಿಗಾಗಿ ಹೆಸರಿರುವ ಸಂಗ್ರಹವನ್ನು ರಚಿಸಿ. ಅದೇ ಸಾಮಾನ್ಯೀಕೃತ ಹೆಸರಿನ ಒಂದು ಸಂಗ್ರಹ ಈಗಾಗಲೇ ಇದ್ದರೆ, ಮತ್ತೊಂದು ರಚಿಸದೆ ಅದನ್ನೇ ಹಿಂತಿರುಗಿಸಿ. ಇದು ಸ್ಥಳಗಳನ್ನು ಸೇರಿಸುವುದಿಲ್ಲ ಅಥವಾ ಪ್ರವಾಸದ ಯೋಜನೆಯನ್ನು ಬದಲಿಸುವುದಿಲ್ಲ."
          }
        }
      }
    },
    "intent_end_tracking_description" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End the current tracked trip day and its Live Activity, keeping recorded visits. Repeating the action leaves tracking ended. Does not delete the itinerary or change bookings."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "दर्ज की गई यात्राएँ बनाए रखते हुए मौजूदा यात्रा-दिन की ट्रैकिंग और उसकी Live Activity समाप्त करें। दोहराने पर ट्रैकिंग समाप्त ही रहती है। यात्रा कार्यक्रम नहीं मिटाता और बुकिंग नहीं बदलता।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ದಾಖಲಿಸಿದ ಭೇಟಿಗಳನ್ನು ಉಳಿಸಿಕೊಂಡು ಪ್ರಸ್ತುತ ಪ್ರವಾಸದ ದಿನದ ಟ್ರ್ಯಾಕಿಂಗ್ ಮತ್ತು ಅದರ Live Activity ಮುಗಿಸಿ. ಪುನರಾವರ್ತಿಸಿದರೂ ಟ್ರ್ಯಾಕಿಂಗ್ ಮುಗಿದ ಸ್ಥಿತಿಯಲ್ಲೇ ಇರುತ್ತದೆ. ವೇಳಾಪಟ್ಟಿಯನ್ನು ಅಳಿಸುವುದಿಲ್ಲ ಅಥವಾ ಬುಕಿಂಗ್‌ಗಳನ್ನು ಬದಲಿಸುವುದಿಲ್ಲ."
          }
        }
      }
    },
    "intent_move_saved_visit" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Saved Place to Day"
          }
        },
        "hi": {
          "stringUnit": {
