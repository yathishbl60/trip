    "collection_ambiguous_name" : {
      "comment": "@symbol collectionAmbiguousName\n@group SiriCollections\n@parameters ",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than one collection already has that name in this trip. Choose an existing collection or use a different name."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस यात्रा में उस नाम के एक से अधिक संग्रह पहले से हैं। कोई मौजूदा संग्रह चुनें या दूसरा नाम रखें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಈ ಪ್ರವಾಸದಲ್ಲಿ ಆ ಹೆಸರಿನ ಒಂದಕ್ಕಿಂತ ಹೆಚ್ಚು ಸಂಗ್ರಹಗಳು ಈಗಾಗಲೇ ಇವೆ. ಇರುವ ಸಂಗ್ರಹವನ್ನು ಆಯ್ಕೆಮಾಡಿ ಅಥವಾ ಬೇರೆ ಹೆಸರು ಬಳಸಿ."
          }
        }
      }
    },
    "collection_invalid_title" : {
      "comment": "@symbol collectionInvalidTitle\n@group SiriCollections\n@parameters ",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a collection name with 1 to 80 characters on a single line."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "संग्रह का नाम एक पंक्ति में 1 से 80 वर्णों का रखें।"
          }
