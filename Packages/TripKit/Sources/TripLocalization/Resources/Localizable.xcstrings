        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इन जगहों को नहीं ले जाया जा सका। दोहराई गई जगहों, भरे हुए दिन या तय आगमन समय की जाँच करें, फिर दोबारा कोशिश करें।"
          }
