    "motion_StopMoveUnavailable": {
      "comment": "@symbol stopMoveUnavailable\n@group Motion\n@parameters \nA drag could not be applied because the destination or itinerary changed, or a constraint prevents it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
