        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಈ ಸಂಗ್ರಹದಲ್ಲಿ ಪ್ರಸ್ತುತ ಉಳಿಸಿದ ಸ್ಥಳಗಳ ಸಂಖ್ಯೆ; ಅವು ಪ್ರವಾಸದ ಯಾವುದೇ ದಿನದ ಯೋಜನೆಯಲ್ಲಿ ಇರಬಹುದು ಅಥವಾ ಇಲ್ಲದಿರಬಹುದು."
          }
        }
      }
    },
    "intent_property_collection_saved_places" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved place names in collection order, separated by newlines. Includes places not scheduled on any trip day; excludes private notes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "संग्रह के क्रम में सहेजी गई जगहों के नाम, हर नाम एक नई पंक्ति में। यात्रा के किसी भी दिन के लिए तय न की गई जगहें भी शामिल हैं; निजी नोट्स शामिल नहीं हैं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಸಂಗ್ರಹದ ಕ್ರಮದಲ್ಲಿ ಉಳಿಸಿದ ಸ್ಥಳಗಳ ಹೆಸರುಗಳು, ಪ್ರತಿ ಹೆಸರು ಹೊಸ ಸಾಲಿನಲ್ಲಿ. ಪ್ರವಾಸದ ಯಾವುದೇ ದಿನಕ್ಕೆ ನಿಗದಿಪಡಿಸದ ಸ್ಥಳಗಳೂ ಸೇರಿವೆ; ಖಾಸಗಿ ಟಿಪ್ಪಣಿಗಳನ್ನು ಒಳಗೊಂಡಿಲ್ಲ."
          }
        }
      }
    },
    "intent_property_collection_title" : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved collection name."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सहेजे गए संग्रह का नाम।"
