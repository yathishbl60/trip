            "state": "needs_review",
            "value": "सहेजा हुआ यात्रा विवरण संपादित करें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಉಳಿಸಿದ ಪ್ರವಾಸ ವಿವರ ಸಂಪಾದಿಸಿ"
          }
        }
      }
    },
    "intent_edit_saved_detail_description": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the exact saved booking’s editor or place’s visit timing form. The person reviews and saves changes in Trip. Does not change a reservation with its provider."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "चुनी गई सहेजी बुकिंग का संपादक या स्थान का भ्रमण समय फ़ॉर्म खोलें। व्यक्ति Trip में समीक्षा करके बदलाव सहेजता है। प्रदाता के साथ आरक्षण नहीं बदलता।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಆಯ್ದ ಉಳಿಸಿದ ಬುಕಿಂಗ್ ಸಂಪಾದಕ ಅಥವಾ ಸ್ಥಳದ ಭೇಟಿ ಸಮಯದ ಫಾರ್ಮ್ ತೆರೆಯಿರಿ. ಬಳಕೆದಾರರು Trip ನಲ್ಲಿ ಪರಿಶೀಲಿಸಿ ಬದಲಾವಣೆಗಳನ್ನು ಉಳಿಸುತ್ತಾರೆ. ಪೂರೈಕೆದಾರರ ಕಾಯ್ದಿರಿಸುವಿಕೆಯನ್ನು ಬದಲಾಯಿಸುವುದಿಲ್ಲ."
          }
        }
      }
    },
    "intent_open_day_tool": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Trip Day Tool"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा के दिन का उपकरण खोलें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರವಾಸದ ದಿನದ ಸಾಧನ ತೆರೆಯಿರಿ"
          }
        }
      }
    },
    "intent_open_day_tool_description": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open an existing day’s map, directions, stop-order suggestion, schedule editor, planning preview, weather review, or place picker. Suggested orders, changes, and new places require review in Trip."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "मौजूदा दिन का नक्शा, रास्ते, स्थानों के क्रम का सुझाव, समय-सारणी संपादक, योजना पूर्वावलोकन, मौसम समीक्षा या स्थान चयन खोलें। सुझाए गए क्रम, बदलाव और नए स्थानों की Trip में समीक्षा आवश्यक है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ದಿನದ ನಕ್ಷೆ, ದಿಕ್ಕುಗಳು, ಸ್ಥಳಗಳ ಕ್ರಮದ ಸಲಹೆ, ವೇಳಾಪಟ್ಟಿ ಸಂಪಾದಕ, ಯೋಜನೆಯ ಪೂರ್ವವೀಕ್ಷಣೆ, ಹವಾಮಾನ ಪರಿಶೀಲನೆ ಅಥವಾ ಸ್ಥಳ ಆಯ್ಕೆ ತೆರೆಯಿರಿ. ಸೂಚಿಸಿದ ಕ್ರಮಗಳು, ಬದಲಾವಣೆಗಳು ಮತ್ತು ಹೊಸ ಸ್ಥಳಗಳಿಗೆ Trip ನಲ್ಲಿ ಪರಿಶೀಲನೆ ಅಗತ್ಯ."
          }
        }
      }
    },
    "intent_open_trip_section": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
