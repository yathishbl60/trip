    "travel_booking_review_explanation": {
      "comment": "@symbol bookingReviewExplanation\n@group NativeTravel\n@parameters \nBooking document import and reviewed extraction.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognition can make mistakes. Check the title, locations, dates, and times against your booking before saving. You can edit every detail in the next step."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "पहचान में गलतियाँ हो सकती हैं। सहेजने से पहले शीर्षक, स्थान, तारीखें और समय अपनी बुकिंग से मिलाएँ। अगले चरण में आप हर विवरण बदल सकते हैं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪಠ್ಯ ಗುರುತಿಸುವಿಕೆಯಲ್ಲಿ ತಪ್ಪುಗಳಾಗಬಹುದು. ಉಳಿಸುವ ಮೊದಲು ಶೀರ್ಷಿಕೆ, ಸ್ಥಳಗಳು, ದಿನಾಂಕಗಳು ಮತ್ತು ಸಮಯಗಳನ್ನು ನಿಮ್ಮ ಬುಕಿಂಗ್‌ನೊಂದಿಗೆ ಪರಿಶೀಲಿಸಿ. ಮುಂದಿನ ಹಂತದಲ್ಲಿ ಪ್ರತಿಯೊಂದು ವಿವರವನ್ನು ಬದಲಾಯಿಸಬಹುದು."
          }
        }
      }
    },
    "travel_booking_detected_times": {
      "comment": "@symbol bookingDetectedTimes\n@group NativeTravel\n@parameters \nBooking document import and reviewed extraction.",
      "extractionState": "manual",
      "localizations": {
