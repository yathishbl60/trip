    "travel_booking_import_explanation": {
      "comment": "@symbol bookingImportExplanation\n@group NativeTravel\n@parameters \nBooking document import and reviewed extraction.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a booking PDF or image. Text is read on your device. Nothing is saved until you review the booking and tap Save."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बुकिंग का PDF या चित्र चुनें। टेक्स्ट आपके डिवाइस पर पढ़ा जाता है। बुकिंग की समीक्षा करके सहेजें दबाने तक कुछ भी सहेजा नहीं जाता।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಬುಕಿಂಗ್ PDF ಅಥವಾ ಚಿತ್ರವನ್ನು ಆಯ್ಕೆಮಾಡಿ. ಪಠ್ಯವನ್ನು ನಿಮ್ಮ ಸಾಧನದಲ್ಲೇ ಓದಲಾಗುತ್ತದೆ. ಬುಕಿಂಗ್ ಪರಿಶೀಲಿಸಿ ಉಳಿಸಿ ಒತ್ತುವವರೆಗೆ ಏನನ್ನೂ ಉಳಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        }
      }
    },
