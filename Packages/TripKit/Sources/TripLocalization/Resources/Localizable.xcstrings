    "intent_open_trip_section_description": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a saved trip’s itinerary, today view, map, checklist, collections, or saved-detail search. Keeps the existing navigation hierarchy."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सहेजी गई यात्रा की योजना, आज का दृश्य, मानचित्र, चेकलिस्ट, संग्रह या विवरण खोज खोलें। मौजूदा नेविगेशन क्रम बना रहता है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಉಳಿಸಿದ ಪ್ರವಾಸದ ಯೋಜನೆ, ಇಂದಿನ ನೋಟ, ನಕ್ಷೆ, ಪರಿಶೀಲನಾ ಪಟ್ಟಿ, ಸಂಗ್ರಹಗಳು ಅಥವಾ ವಿವರ ಹುಡುಕಾಟ ತೆರೆಯಿರಿ. ಈಗಿರುವ ನ್ಯಾವಿಗೇಶನ್ ಕ್ರಮ ಉಳಿಯುತ್ತದೆ."
          }
        }
      }
    },
    "intent_open_trip_tool": {
      "comment": "Siri navigation and review. Opening an editor does not save changes or export data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Trip Tool"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यात्रा उपकरण खोलें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರವಾಸ ಸಾಧನ ತೆರೆಯಿರಿ"
          }
        }
