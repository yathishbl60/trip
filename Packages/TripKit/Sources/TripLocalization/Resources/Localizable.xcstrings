    "travel_travel_alarm_time": {
      "comment": "@symbol travelAlarmTime\n@group NativeTravel\n@parameters \nCalendar, Reminders, or travel alarm system action UI.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm time"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अलार्म का समय"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಅಲಾರ್ಮ್ ಸಮಯ"
          }
        }
      }
    },
    "travel_travel_alarm_explanation": {
      "comment": "@symbol travelAlarmExplanation\n@group NativeTravel\n@parameters \nCalendar, Reminders, or travel alarm system action UI.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the exact time to be alerted, in this booking’s time zone. The suggested time uses your saved travel allowance, not live traffic. Changing or deleting the saved booking cancels its alarm."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इस बुकिंग के समय क्षेत्र में अलर्ट का सही समय चुनें। सुझाया गया समय आपके सहेजे गए यात्रा समय पर आधारित है, लाइव ट्रैफ़िक पर नहीं। सहेजी गई बुकिंग बदलने या हटाने पर उसका अलार्म रद्द हो जाता है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಈ ಬುಕಿಂಗ್‌ನ ಸಮಯ ವಲಯದಲ್ಲಿ ಎಚ್ಚರಿಕೆಯ ನಿಖರ ಸಮಯವನ್ನು ಆಯ್ಕೆಮಾಡಿ. ಸೂಚಿಸಿದ ಸಮಯವು ನೀವು ಉಳಿಸಿದ ಪ್ರಯಾಣದ ಅವಧಿಯನ್ನು ಬಳಸುತ್ತದೆ, ನೇರ ಸಂಚಾರ ಮಾಹಿತಿಯನ್ನಲ್ಲ. ಉಳಿಸಿದ ಬುಕಿಂಗ್ ಬದಲಿಸಿದರೆ ಅಥವಾ ಅಳಿಸಿದರೆ ಅದರ ಅಲಾರ್ಮ್ ರದ್ದಾಗುತ್ತದೆ."
          }
        }
      }
    },
