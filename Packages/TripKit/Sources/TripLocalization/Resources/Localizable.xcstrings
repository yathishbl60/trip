    "travel_weather_visit_limit": {
      "comment": "@symbol weatherVisitLimit\n@group NativeTravel\n@parameters \nTrip hourly visit weather presentation; translation needs review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows up to eight visits with valid coordinates and reviewed times. Untimed or unreviewed visits are omitted."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "मान्य स्थान और समीक्षित समय वाले अधिकतम आठ भ्रमण दिखाए जाते हैं। बिना समय या समीक्षा वाले भ्रमण शामिल नहीं हैं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಮಾನ್ಯ ಸ್ಥಳಗಳು ಮತ್ತು ಪರಿಶೀಲಿಸಿದ ಸಮಯಗಳಿರುವ ಎಂಟು ಭೇಟಿಗಳವರೆಗೆ ತೋರಿಸುತ್ತದೆ. ಸಮಯವಿಲ್ಲದ ಅಥವಾ ಪರಿಶೀಲಿಸದ ಭೇಟಿಗಳನ್ನು ಬಿಟ್ಟುಬಿಡಲಾಗಿದೆ."
          }
        }
      }
    },
