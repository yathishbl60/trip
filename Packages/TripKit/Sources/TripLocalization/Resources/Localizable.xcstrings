    "planning_Allowances": {
      "comment": "@symbol planningAllowances\n@group Planning\n@parameters \nTrip day review and placement UI. String argument is a place, booking name, or formatted duration.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedule uses your saved travel and buffer allowances. Route estimates below use current conditions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "समय-सारणी आपके सहेजे गए यात्रा और अतिरिक्त समय का उपयोग करती है। मार्ग के अनुमान वर्तमान स्थितियों पर आधारित हैं।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ವೇಳಾಪಟ್ಟಿ ಉಳಿಸಿದ ಪ್ರಯಾಣ ಮತ್ತು ಹೆಚ್ಚುವರಿ ಸಮಯವನ್ನು ಬಳಸುತ್ತದೆ. ಮಾರ್ಗದ ಅಂದಾಜುಗಳು ಪ್ರಸ್ತುತ ಪರಿಸ್ಥಿತಿಗಳನ್ನು ಬಳಸುತ್ತವೆ."
          }
        }
      }
    },
