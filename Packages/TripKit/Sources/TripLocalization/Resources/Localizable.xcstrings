          }
        }
      }
    },
    "intent_mark_saved_visit": {
      "comment": "Siri saved-place actions. Navigation and visit tracking remain separate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark Saved Place Visited"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सहेजी जगह को देखी गई चिह्नित करें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಉಳಿಸಿದ ಸ್ಥಳಕ್ಕೆ ಭೇಟಿ ನೀಡಲಾಗಿದೆ ಎಂದು ಗುರುತಿಸಿ"
          }
        }
      }
    },
    "intent_mark_saved_visit_description": {
      "comment": "Siri saved-place actions. Navigation and visit tracking remain separate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record an explicitly completed visit to the exact next place in the tracked trip day. Repeating the same visit does not advance another stop. Does not complete bookings or start tracking."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ट्रैक किए जा रहे यात्रा दिन की ठीक अगली जगह का पूरा हुआ भ्रमण दर्ज करें। वही भ्रमण दोहराने से दूसरी जगह पूरी नहीं होती। बुकिंग पूरी या ट्रैकिंग शुरू नहीं करता।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಟ್ರ್ಯಾಕ್ ಮಾಡುತ್ತಿರುವ ಪ್ರವಾಸದ ದಿನದ ಮುಂದಿನ ನಿಖರ ಸ್ಥಳದ ಪೂರ್ಣಗೊಂಡ ಭೇಟಿಯನ್ನು ದಾಖಲಿಸಿ. ಅದೇ ಭೇಟಿ ಪುನರಾವರ್ತನೆಯಾದರೆ ಮತ್ತೊಂದು ನಿಲ್ದಾಣ ಮುಂದುವರಿಯುವುದಿಲ್ಲ. ಬುಕಿಂಗ್ ಪೂರ್ಣಗೊಳಿಸುವುದಿಲ್ಲ ಅಥವಾ ಟ್ರ್ಯಾಕಿಂಗ್ ಆರಂಭಿಸುವುದಿಲ್ಲ."
          }
        }
      }
    },
    "intent_parameter_tracked_visit": {
      "comment": "Siri saved-place actions. Navigation and visit tracking remain separate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved place the person says they visited. It must be next in the tracked day or already recorded; never substitute another place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वह सहेजी जगह जिसे व्यक्ति देख चुका है। यह ट्रैक किए दिन की अगली या पहले दर्ज जगह होनी चाहिए; दूसरी जगह न चुनें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ವ್ಯಕ್ತಿ ಭೇಟಿ ನೀಡಿರುವುದಾಗಿ ಹೇಳಿದ ಉಳಿಸಿದ ಸ್ಥಳ. ಇದು ಟ್ರ್ಯಾಕ್ ಮಾಡುವ ದಿನದ ಮುಂದಿನ ಸ್ಥಳ ಅಥವಾ ಈಗಾಗಲೇ ದಾಖಲಾದ ಸ್ಥಳವಾಗಿರಬೇಕು; ಬೇರೆ ಸ್ಥಳವನ್ನು ಬದಲಿಸಬೇಡಿ."
          }
        }
      }
    },
    "intent_directions_saved_visit": {
      "comment": "Siri saved-place actions. Navigation and visit tracking remain separate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Directions to Saved Place"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सहेजी जगह तक दिशा-निर्देश"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಉಳಿಸಿದ ಸ್ಥಳಕ್ಕೆ ದಿಕ್ಕುಗಳು"
          }
        }
      }
    },
    "intent_directions_saved_visit_description": {
      "comment": "Siri saved-place actions. Navigation and visit tracking remain separate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Apple Maps directions to the saved coordinates of one itinerary place. Does not mark a visit complete, start trip tracking, or claim a live arrival time."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कार्यक्रम की एक जगह के सहेजे निर्देशांक तक Apple Maps दिशा-निर्देश खोलें। भ्रमण पूरा नहीं करता, ट्रैकिंग शुरू नहीं करता और लाइव आगमन समय नहीं बताता।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ವೇಳಾಪಟ್ಟಿಯ ಒಂದು ಸ್ಥಳದ ಉಳಿಸಿದ ನಿರ್ದೇಶಾಂಕಗಳಿಗೆ Apple Maps ದಿಕ್ಕುಗಳನ್ನು ತೆರೆಯಿರಿ. ಭೇಟಿಯನ್ನು ಪೂರ್ಣಗೊಳಿಸುವುದಿಲ್ಲ, ಟ್ರ್ಯಾಕಿಂಗ್ ಆರಂಭಿಸುವುದಿಲ್ಲ ಅಥವಾ ನೇರ ಆಗಮನ ಸಮಯ ಹೇಳುವುದಿಲ್ಲ."
          }
        }
      }
    },
    "intent_parameter_directions_visit": {
      "comment": "Siri saved-place actions. Navigation and visit tracking remain separate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exact saved itinerary place to navigate to, with valid map coordinates. Bookings without a saved place are not supported."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वह सहेजी कार्यक्रम जगह जहाँ जाना है, मान्य मानचित्र निर्देशांकों के साथ। सहेजी जगह के बिना बुकिंग समर्थित नहीं है।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಮಾನ್ಯ ನಕ್ಷೆ ನಿರ್ದೇಶಾಂಕಗಳಿರುವ, ತಲುಪಬೇಕಾದ ನಿಖರ ಉಳಿಸಿದ ವೇಳಾಪಟ್ಟಿ ಸ್ಥಳ. ಉಳಿಸಿದ ಸ್ಥಳವಿಲ್ಲದ ಬುಕಿಂಗ್ ಬೆಂಬಲಿತವಾಗಿಲ್ಲ."
          }
        }
      }
    },
    "intent_parameter_place_search": {
      "comment": "Siri saved-place actions. Navigation and visit tracking remain separate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One place name or address to search in Apple Maps. The person chooses a result in Trip before anything is saved. Do not provide a URL or booking document."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple Maps में खोजने के लिए एक जगह का नाम या पता। कुछ सहेजने से पहले व्यक्ति Trip में परिणाम चुनता है। URL या बुकिंग दस्तावेज़ न दें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple Maps ನಲ್ಲಿ ಹುಡುಕಲು ಒಂದು ಸ್ಥಳದ ಹೆಸರು ಅಥವಾ ವಿಳಾಸ. ಉಳಿಸುವ ಮೊದಲು ವ್ಯಕ್ತಿ Trip ನಲ್ಲಿ ಫಲಿತಾಂಶ ಆಯ್ಕೆಮಾಡುತ್ತಾರೆ. URL ಅಥವಾ ಬುಕಿಂಗ್ ದಾಖಲೆ ನೀಡಬೇಡಿ."
          }
        }
      }
    },
    "Mark ${place} visited": {
      "comment": "Siri saved-place actions. Navigation and visit tracking remain separate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark ${place} visited"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "${place} को देखी गई चिह्नित करें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "${place} ಗೆ ಭೇಟಿ ನೀಡಲಾಗಿದೆ ಎಂದು ಗುರುತಿಸಿ"
          }
        }
      }
    },
    "Get directions to ${place}": {
      "comment": "Siri saved-place actions. Navigation and visit tracking remain separate.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get directions to ${place}"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "${place} तक दिशा-निर्देश पाएँ"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "${place} ಗೆ ದಿಕ್ಕುಗಳನ್ನು ಪಡೆಯಿರಿ"
