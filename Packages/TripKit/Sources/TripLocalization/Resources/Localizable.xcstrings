    "intent_property_detail_start": {
      "comment": "Siri and Shortcuts metadata; describes saved Trip data or an action parameter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved start instant, if set. Use Saved times for local clock and time-zone details."
          }
